{% comment %} Section: Split Slideshow (Image Left / Text on Black Right) {% endcomment %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');

  .split-slider {
    width: 100vw;
    position: relative;
    left: 50%;
    margin-left: -50vw;
    box-sizing: border-box;
    background-color: #11151a;
    overflow: hidden;
  }

  .split-slider__track {
    display: flex;
    transition: transform 0.45s ease;
  }

  .split-slider__slide {
    flex: 0 0 100%;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 560px;
  }

  .split-slider__media {
    position: relative;
    overflow: hidden;
    background-color: #000000;
  }

  .split-slider__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .split-slider__content {
    background-color: #11151a;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 72px;
    box-sizing: border-box;
  }

  .split-slider__heading {
    font-family: 'Anton', sans-serif;
    font-size: 32px;
    font-weight: 400;
    color: #ffffff;
    letter-spacing: 0.01em;
    line-height: 1.25;
    margin: 0 0 24px 0;
  }

  .split-slider__text {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 14px;
    color: #aaaaaa;
    line-height: 1.85;
    margin: 0 0 32px 0;
  }

  .split-slider__text strong {
    color: #d4af37;
    font-weight: 700;
  }

  .split-slider__button {
    display: inline-block;
    align-self: flex-start;
    font-family: Helvetica, Arial, sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #11151a;
    background-color: #d4af37;
    padding: 16px 32px;
    text-decoration: none;
    border: none;
    transition: background-color 0.2s ease;
  }

  .split-slider__button:hover {
    background-color: #c29b2c;
  }

  .split-slider__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: none;
    background-color: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    -webkit-tap-highlight-color: transparent;
    padding: 0;
  }

  .split-slider__nav svg {
    width: 26px;
    height: 26px;
    color: #d4af37;
  }

  .split-slider__nav--prev { left: 16px; }
  .split-slider__nav--next { right: 16px; }

  .split-slider__dots {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    z-index: 2;
  }

  .split-slider__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.3);
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .split-slider__dot.is-active {
    background-color: #d4af37;
  }

  @media (max-width: 900px) {
    .split-slider__slide {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .split-slider__media {
      aspect-ratio: 4 / 3;
    }

    .split-slider__content {
      padding: 40px 24px 72px 24px;
    }

    .split-slider__heading {
      font-size: 24px;
      margin-bottom: 16px;
    }

    .split-slider__text {
      font-size: 13px;
      margin-bottom: 24px;
    }

    .split-slider__button {
      font-size: 13px;
      padding: 14px 26px;
    }

    .split-slider__nav {
      width: 36px;
      height: 36px;
      top: auto;
      bottom: 26px;
      transform: none;
    }

    .split-slider__nav svg {
      width: 20px;
      height: 20px;
    }

    .split-slider__nav--prev { left: 14px; }
    .split-slider__nav--next { right: 14px; }

    .split-slider__dots {
      bottom: 30px;
    }
  }
</style>

<div class="split-slider" data-split-slider>
  <div class="split-slider__track" data-split-slider-track>

    <div class="split-slider__slide">
      <div class="split-slider__media">
        <img src="data:image/jpeg;base64," alt="1st Added Lock Reinforcement: Deadbolt Support" loading="lazy">
      </div>
      <div class="split-slider__content">
        <h2 class="split-slider__heading">1st Added Lock Reinforcement: Deadbolt Support</h2>
        <p class="split-slider__text">Unlike other safe makers who rely solely on the lock's built-in strength, Sturdy goes a step further. We reinforce the lock itself to withstand over <strong>16,000 pounds</strong> of resistance pressure on its deadbolt, making forced entry exponentially more difficult. This is achieved with a specially designed steel cradle that supports and stabilizes the deadbolt while in the locked position, preventing fractures or shattering under extreme force.</p>
        <a href="https://www.ar15.com/forums/General/Amsec-safe-failed-within-48-hrs-SAFE-OPENED-/5-2204912/?page=1" class="split-slider__button" target="_blank" rel="noopener">Forum Complaint</a>
      </div>
    </div>

    <div class="split-slider__slide">
      <div class="split-slider__media">
        <img src="data:image/jpeg;base64," alt="2nd Added Lock Reinforcement: Punch Plate" loading="lazy">
      </div>
      <div class="split-slider__content">
        <h2 class="split-slider__heading">2nd Added Lock Reinforcement: Punch Plate</h2>
        <p class="split-slider__text">In addition the Deadbolt Support, at the back of every combination box, we add a <strong>10-gauge steel punch plate</strong> that provides an extra barrier against attacks attempting to punch out the back of the original lock plate. This reinforcement prevents manipulation of the lock to gain entry. Together, these defenses form one of the toughest, most abuse-resistant locking systems available anywhere.</p>
      </div>
    </div>

    <div class="split-slider__slide">
      <div class="split-slider__media">
        <img src="data:image/jpeg;base64," alt="Drill Resistant Hardplate" loading="lazy">
      </div>
      <div class="split-slider__content">
        <h2 class="split-slider__heading">Drill Resistant Hardplate</h2>
        <p class="split-slider__text">Our <strong>1/4" thick hardened hardplate</strong> is engineered to stop drill, punch, and manipulation attacks aimed at the combination box and relockers. Unlike welded-on hardplates that can fracture at the seam, our hardplate floats in place, eliminating weak weld points and greatly increasing resistance to forced entry. Its oversized design protects the combination box in its entirety and then some, so attackers can't reach the mechanism even when they try to bore through the door. For customers who want maximum delay against locksmith-style attacks, we offer an <strong>Additional Hardplate Upgrade</strong> that doubles entry time. It's only recommended for those who believe burglars are so smart they know locksmith entries, which we have never seen in our whole history.</p>
      </div>
    </div>

    <div class="split-slider__slide">
      <div class="split-slider__media">
        <img src="data:image/jpeg;base64," alt="Premium Sargent & Greenleaf Locks" loading="lazy">
      </div>
      <div class="split-slider__content">
        <h2 class="split-slider__heading">Premium Sargent &amp; Greenleaf Locks</h2>
        <p class="split-slider__text">Every Sturdy Safe and Vault Door comes standard with a <strong>UL-rated, Group II commercial combination lock</strong> by Sargent &amp; Greenleaf (Model 6730-009) &mdash; a trusted name in high-security locking systems. For customers who prefer electronic access, we offer <strong>S&amp;G Type 1 Titan D-Drive locks</strong>, a hybrid design that combines mechanical durability with electronic convenience for long-term reliability. While not all S&amp;G locks are created equal, we only use their premium models &mdash; locks that most manufacturers skip to cut costs. For added convenience, owners can change their own combination &mdash; no locksmith required.</p>
      </div>
    </div>

    <div class="split-slider__slide">
      <div class="split-slider__media">
        <img src="data:image/jpeg;base64," alt="2 Independent Relock Systems" loading="lazy">
      </div>
      <div class="split-slider__content">
        <h2 class="split-slider__heading">2 Independent Relock Systems &mdash; Smart Protection That Responds To Real Threats</h2>
        <p class="split-slider__text">Sturdy Gun Safe's patented <strong>pressure-activated relocker</strong> is engineered to engage intelligently, making it incredibly difficult to defeat. Just as modern cars are designed to crumple in a controlled way during a crash, our relock system is designed to trigger only under the right amount of force &mdash; not from minor bumps or everyday use. Unlike sensitive spring or glass relockers used by other manufacturers, ours won't accidentally lock you out over a simple mishap that would otherwise require a locksmith. When a real attack occurs, the relocker fires instantly and securely, locking the system down. And because it's protected behind hardened steel, once engaged, it's extremely difficult to bypass. A second independent relock is located in the Sargent &amp; Greenleaf combination box, adding yet another layer of security.</p>
      </div>
    </div>

  </div>

  <button class="split-slider__nav split-slider__nav--prev" data-split-slider-prev aria-label="Previous slide">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg>
  </button>
  <button class="split-slider__nav split-slider__nav--next" data-split-slider-next aria-label="Next slide">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
  </button>

  <div class="split-slider__dots" data-split-slider-dots></div>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    var track = root.querySelector('[data-split-slider-track]');
    var slides = root.querySelectorAll('.split-slider__slide');
    var prevBtn = root.querySelector('[data-split-slider-prev]');
    var nextBtn = root.querySelector('[data-split-slider-next]');
    var dotsWrap = root.querySelector('[data-split-slider-dots]');
    var current = 0;

    if (slides.length <= 1) {
      if (prevBtn) prevBtn.style.display = 'none';
      if (nextBtn) nextBtn.style.display = 'none';
    }

    slides.forEach(function (_, i) {
      var dot = document.createElement('button');
      dot.className = 'split-slider__dot' + (i === 0 ? ' is-active' : '');
      dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      dot.addEventListener('click', function () { goTo(i); });
      dotsWrap.appendChild(dot);
    });

    var dots = dotsWrap.querySelectorAll('.split-slider__dot');

    function goTo(index) {
      current = (index + slides.length) % slides.length;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach(function (d, i) {
        d.classList.toggle('is-active', i === current);
      });
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); });
  })();
</script>

{% schema %}
{
  "name": "Split Slideshow",
  "settings": [],
  "presets": [
    {
      "name": "Split Slideshow"
    }
  ]
}
{% endschema %}
