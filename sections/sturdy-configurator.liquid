{% comment %}
  ═══════════════════════════════════════════════════════
  STURDY SAFE CONFIGURATOR — Shopify Section
  ═══════════════════════════════════════════════════════

  INSTALLATION:
  1. Shopify Admin → Online Store → Themes → Edit Code
  2. Under "Sections" → Add new section → name: "sturdy-configurator"
  3. Delete all default content, paste this entire file
  4. Save

  Then create the page:
  5. Under "Templates" → Add new template → type "page" → name "configurator"
  6. Paste this JSON:
     {
       "sections": {
         "main": { "type": "sturdy-configurator", "settings": {} }
       },
       "order": ["main"]
     }
  7. Save
  8. Go to Online Store → Pages → Add page
  9. Title: "Configure Your Safe"
  10. Template: page.configurator
  11. Save → Done!

  JS BUNDLE:
  Upload sturdy-configurator.min.js to:
  Settings → Files (or Content → Files)
  Then update the script src below with the URL Shopify gives you.
  OR: leave it loading from the theme assets folder (see step below).

  ALTERNATIVE (assets folder):
  1. In theme editor, under "Assets" → Add new asset
  2. Upload sturdy-configurator.min.js
  3. The script tag below already references it via asset_url
{% endcomment %}

<style>
  /* Hide the default page title since the configurator has its own */
  .section-configurator + .page-width h1.page-title,
  .template-page .page-header { display: none; }
  /* Ensure full width on the configurator page */
  .section-configurator { max-width: 100%; padding: 0; }

  /*
    Ritual (Horizon family) compatibility layer.
    sturdy-configurator.min.js was built against Dawn, which the live store ran
    until this theme. Everything below lives here in the section so the exact
    same bundle can be served by either theme.
  */

  /*
    1. Fonts. The bundle reads Dawn's variable names (--font-body-family,
       --font-heading-family). Ritual names them --font-body--family and
       --font-heading--family. Bridge them so the configurator keeps inheriting
       the theme's fonts instead of falling back to Playfair Display.
  */
  #sturdy-configurator-mount {
    --font-body-family: var(--font-body--family);
    --font-heading-family: var(--font-heading--family);
  }

  /*
    2. Text metrics. The configurator's layout was tuned on Dawn's body text
       (font-body-scale 1.05: 15.75px, 16.8px from 750px up, 0.06rem tracking,
       line-height 1 + 0.8 / 1.05). Ritual's body is 14px with no tracking and a
       1.4 line-height, which every configurator element without an inline size
       would inherit. Pin the Dawn values on the configurator root.
  */
  #sturdy-configurator-mount .sc {
    font-size: 15.75px;
    letter-spacing: 0.63px;
    line-height: calc(1 + 0.8 / 1.05);
    text-transform: none;
  }
  @media screen and (min-width: 750px) {
    #sturdy-configurator-mount .sc { font-size: 16.8px; }
  }

  /*
    3. Ritual's element-level rules. These selectors are kept at the same
       specificity as the bundle's own rules (one class plus one element) so they
       beat Ritual's base.css, while the bundle's stylesheet, which renders later
       inside .sc, and its inline styles still win.
  */
  /* Ritual sets h1 to h5 in uppercase with its own tracking and leading. */
  :where(#sturdy-configurator-mount) .sc :is(h1, h2, h3, h4, h5, h6) {
    text-transform: none;
    letter-spacing: 0.6px;
    line-height: 1.3;
  }
  /* Ritual zeroes the outer margins of first and last paragraphs. */
  :where(#sturdy-configurator-mount) .sc p {
    margin-block: 1em;
  }
  /* Ritual makes every img and svg a full-width block. */
  :where(#sturdy-configurator-mount) .sc img {
    display: inline;
    max-width: none;
    width: auto;
    height: auto;
  }
  :where(#sturdy-configurator-mount) .sc svg {
    display: inline;
    max-width: none;
  }

  /*
    4. Sticky header. Ritual's header is set to reappear on scroll up, and the
       configurator scrolls back to its top on every step change, so keep the
       step pills clear of the header. Ritual keeps --header-height current on body.
  */
  #sturdy-configurator-mount #sc-root {
    scroll-margin-top: var(--header-height, 0px);
  }
</style>

<div id="sturdy-configurator-mount" style="min-height: 600px;">
  <noscript>
    <div style="text-align:center; padding: 60px 20px; font-family: 'Source Sans 3', sans-serif;">
      <h2 style="font-family: 'Playfair Display', serif; font-size: 32px;">Configure Your Safe</h2>
      <p style="color: #888; margin-top: 12px;">JavaScript is required to use our safe configurator.</p>
      <p>Please enable JavaScript or <a href="/pages/contact" style="color: #8B6914;">contact us directly</a> at <a href="tel:8002620023" style="color: #8B6914;">800-262-0023</a>.</p>
    </div>
  </noscript>
  <div id="sc-loading" style="text-align:center; padding: 80px 20px; font-family: 'Source Sans 3', sans-serif;">
    <div style="width:40px;height:40px;border:3px solid #eae8e5;border-top-color:#1a1a1a;border-radius:50%;animation:spin .8s linear infinite;margin:0 auto"></div>
    <p style="color:#999;margin-top:16px;font-size:14px;">Loading configurator...</p>
    <style>@keyframes spin{to{transform:rotate(360deg)}}</style>
  </div>
</div>

{%- comment -%} Fonts {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">

{%- comment -%}
  Live Shopify prices for the configurator. Each model's price follows its Shopify product
  (first variant), so a price changed on the product page shows here too, and a higher
  compare-at price is shown struck through, as on the product page. Printed only when
  the "Use Shopify product prices" setting is on and the shopper sees the store's own currency
  (the draft order is priced in it). Models without a product here keep the admin price.
{%- endcomment -%}
<script>
  window.__STURDY_PRICES__ = {% if section.settings.use_shopify_prices and cart.currency.iso_code == shop.currency %}{
    {%- for p in collections.all.products limit: 50 -%}
      {{ p.handle | json }}: {"p": {{ p.variants.first.price | default: 0 }}, "c": {{ p.variants.first.compare_at_price | default: 0 }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }{% else %}null{% endif %};
</script>

{%- comment -%}
  Spec sheet download on the review step. The bundle loads these files only when a shopper clicks
  "Download Spec Sheet": jsPDF 4.2.1 (MIT license) and Latin subsets of Anton and Inter (SIL Open Font
  License 1.1, https://openfontlicense.org), plus the logo from Theme settings. Printed as null when the
  "Show spec sheet download" setting is off, which hides the button.
{%- endcomment -%}
<script>
  window.__STURDY_SPEC__ = {% if section.settings.show_spec_sheet %}{
    "lib": {{ 'sturdy-jspdf.umd.min.js' | asset_url | json }},
    "anton": {{ 'sturdy-spec-anton.ttf' | asset_url | json }},
    "inter": {{ 'sturdy-spec-inter.ttf' | asset_url | json }},
    "interBold": {{ 'sturdy-spec-inter-semibold.ttf' | asset_url | json }},
    "logo": {% if settings.logo %}{{ settings.logo | image_url: width: 800 | json }}{% else %}""{% endif %}
  }{% else %}null{% endif %};
</script>

{%- comment -%} React 18 Production, pinned to the exact release the bundle is tested with {%- endcomment -%}
<script src="https://unpkg.com/react@18.3.1/umd/react.production.min.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js" crossorigin></script>

{%- comment -%}
  Configurator bundle — UPDATE THIS PATH after uploading the .min.js file.
  Option A: Upload to Settings → Files, then use the full Shopify CDN URL
  Option B: Upload to Assets folder in theme editor, then use:
    {{ 'sturdy-configurator.min.js' | asset_url }}
{%- endcomment -%}
<script src="{{ 'sturdy-configurator.min.js' | asset_url }}" defer></script>

<script>
  // Mount the configurator after everything loads
  (function initConfigurator() {
    function mount() {
      var el = document.getElementById('sturdy-configurator-mount');
      var loading = document.getElementById('sc-loading');
      if (!el || !window.React || !window.ReactDOM || !window.SturdyConfigurator) {
        // Retry in 100ms if scripts haven't loaded yet
        if (document.readyState !== 'complete') {
          setTimeout(mount, 100);
          return;
        }
        if (loading) loading.innerHTML = '<p style="color:#999;font-family:sans-serif;">Error loading configurator. Please refresh or <a href="/pages/contact">contact us</a>.</p>';
        return;
      }
      if (loading) loading.remove();
      var root = ReactDOM.createRoot(el);
      root.render(React.createElement(window.SturdyConfigurator));
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mount);
    } else {
      mount();
    }
  })();
</script>

{% schema %}
{
  "name": "Safe Configurator",
  "tag": "section",
  "class": "section-configurator",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_shopify_prices",
      "label": "Use Shopify product prices",
      "info": "Each model's price follows its Shopify product, so a price changed on the product page shows here too. Turn off to use the prices set in the configurator admin.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_spec_sheet",
      "label": "Show spec sheet download",
      "info": "Adds a Download Spec Sheet (PDF) button to the review step, with the shopper's configuration, price, product specs and photo.",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Safe Configurator"
    }
  ]
}
{% endschema %}