    "custom_liquid_gkFagL": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  .trust-bar {\n    background-color: #060b17;\n    padding: 36px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .trust-bar__inner {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: 24px;\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  .trust-bar__item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    gap: 10px;\n    cursor: default;\n    transition: transform 0.25s ease;\n  }\n\n  .trust-bar__item:hover {\n    transform: scale(1.1);\n  }\n\n  .trust-bar__item svg {\n    width: 28px;\n    height: 28px;\n    color: #d4af37;\n    flex-shrink: 0;\n  }\n\n  .trust-bar__item span {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 300;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: #aaaaaa;\n    white-space: normal;\n    line-height: 1.5;\n    max-width: 190px;\n  }\n\n  @media (max-width: 900px) {\n    .trust-bar__inner {\n      grid-template-columns: repeat(3, 1fr);\n      gap: 28px 16px;\n    }\n\n    .trust-bar__item span {\n      font-size: 10px;\n      max-width: 170px;\n    }\n  }\n\n  @media (max-width: 600px) {\n    .trust-bar__inner {\n      grid-template-columns: 1fr 1fr;\n      gap: 28px 16px;\n    }\n  }\n\n  @media (max-width: 400px) {\n    .trust-bar__inner {\n      grid-template-columns: 1fr;\n    }\n\n    .trust-bar__item span {\n      max-width: 200px;\n    }\n  }\n</style>\n\n<div class=\"trust-bar\">\n  <div class=\"trust-bar__inner\">\n\n    <div class=\"trust-bar__item\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-1.5 6h13L17 13M9 21a1 1 0 100-2 1 1 0 000 2zm10 0a1 1 0 100-2 1 1 0 000 2z\"/>\n      </svg>\n      <span>American Made Since 1959</span>\n    </div>\n\n    <div class=\"trust-bar__item\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z\"/>\n      </svg>\n      <span>30 Day Full Refund Return Policy</span>\n    </div>\n\n    <div class=\"trust-bar__item\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z\"/>\n      </svg>\n      <span> Lifetime Mechanical Dial Warranty </span>\n    </div>\n\n    <div class=\"trust-bar__item\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12\"/>\n      </svg>\n      <span>Lifetime Shipping And Locksmith Coverage</span>\n    </div>\n\n    <div class=\"trust-bar__item\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M11.