    "custom_liquid_iAdkPm": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<!-- STURDY SAFE | HOMEPAGE FAQ -->\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');\n\n  .faq-home-section {\n    background-color: #11151a;\n    padding: 60px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .faq-home-section *,\n  .faq-home-section *::before,\n  .faq-home-section *::after {\n    box-sizing: border-box;\n  }\n\n  .faq-home-section__inner {\n    max-width: 900px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .faq-home-section__title {\n    font-family: 'Anton', sans-serif;\n    font-size: 36px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: 0 0 12px;\n    letter-spacing: 0.01em;\n    text-transform: uppercase;\n  }\n\n  .faq-home-section__subtitle {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 15px;\n    line-height: 1.7;\n    color: #b7bac0;\n    margin: 0 0 36px;\n  }\n\n  .faq-home-section__list {\n    border-top: 1px solid #303640;\n    text-align: left;\n  }\n\n  .faq-home-section__item {\n    border-bottom: 1px solid #303640;\n  }\n\n  .faq-home-section__question {\n    width: 100%;\n    background: transparent;\n    border: none;\n    padding: 23px 0;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    cursor: pointer;\n    text-align: left;\n    color: inherit;\n  }\n\n  .faq-home-section__question:focus-visible {\n    outline: 2px solid #d4af37;\n    outline-offset: 3px;\n  }\n\n  .faq-home-section__question-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 16px;\n    font-weight: 700;\n    color: #ffffff;\n    line-height: 1.5;\n  }\n\n  .faq-home-section__icon {\n    flex-shrink: 0;\n    width: 20px;\n    height: 20px;\n    color: #d4af37;\n    transition: transform 0.25s ease;\n  }\n\n  .faq-home-section__question[aria-expanded=\"true\"]\n  .faq-home-section__icon {\n    transform: rotate(45deg);\n  }\n\n  .faq-home-section__answer[hidden] {\n    display: none;\n  }\n\n  .faq-home-section__answer-inner {\n    padding: 0 36px 24px 0;\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 15px;\n    color: #c5c7cb;\n    line-height: 1.8;\n  }\n\n  .faq-home-section__answer-inner p {\n    margin: 0 0 12px;\n  }\n\n  .faq-home-section__answer-inner p:last-child {\n    margin-bottom: 0;\n  }\n\n  .faq-home-section__answer-inner a {\n    color: #e1bd55;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  .faq-home-section__footer {\n    margin-top: 32px;\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: #b7bac0;\n    line-height: 1.7;\n  }\n\n  .faq-home-section__footer a {\n    color: #e1bd55;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  @media (max-width: 768px) {\n    .faq-home-section {\n      padding: 45px 20px;\n    }\n\n    .faq-home-section__title {\n      font-size: 28px;\n    }\n\n    .faq-home-section__subtitle {\n      font-size: 14px;\n      margin-bottom: 28px;\n    }\n\n    .faq-home-section__question {\n      padding: 19px 0;\n    }\n\n    .faq-home-section__question-text {\n      font-size: 14px;\n    }\n\n    .faq-home-section__answer-inner {\n      font-size: 14px;\n      padding-right: 8px;\n      padding-bottom: 22px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .faq-home-section__icon {\n      transition: none;\n    }\n  }\n</style>\n\n<section class=\"faq-home-section\"\n         id=\"sturdy-home-faq\"\n         aria-labelledby=\"sturdy-home-faq-title\">\n\n  <div class=\"faq-home-section__inner\">\n\n    <h2 class=\"faq-home-section__title\"\n        id=\"sturdy-home-faq-title\">\n      COMMON QUESTIONS BEFORE YOU BUY\n    </h2>\n\n    <p class=\"faq-home-section__subtitle\">\n      Get your straight answers here.\n    </p>\n\n    <div class=\"faq-home-section__list\">\n\n      <!-- QUESTION 1 -->\n      <div class=\"faq-home-section__item\">\n\n        <button class=\"faq-home-section__question\"\n                type=\"button\"\n                id=\"faq-home-q1\"\n                aria-expanded=\"false\"\n                aria-controls=\"faq-home-a1\">\n\n          <span class=\"faq-home-section__question-text\">\n            How thick is the steel on a Sturdy Gun Safe?\n          </span>\n\n          <svg class=\"faq-home-section__icon\"\n               xmlns=\"http://www.w3.org/2000/svg\"\n               fill=\"none\"\n               viewBox=\"0 0 24 24\"\n               stroke=\"currentColor\"\n               stroke-width=\"2.5\"\n               aria-hidden=\"true\">\n            <path stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  d=\"M12 4.5v15m7.5-7.5h-15\"/>\n          </svg>\n        </button>\n\n        <div class=\"faq-home-section__answer\"\n             id=\"faq-home-a1\"\n             role=\"region\"\n             aria-labelledby=\"faq-home-q1\"\n             hidden>\n\n          <div class=\"faq-home-section__answer-inner\">\n            <p>\n              Our Heavy Duty safes feature a\n              <strong>4-gauge (.224\") steel body\n              and a 3/8\" solid steel door plate.</strong>\n              That's nearly twice the body steel\n              thickness of many comparably priced\n              gun safes.\n            </p>\n\n            <p>\n              Our Essential line starts with\n              3/16\" steel body construction.\n              We also offer additional steel\n              upgrades for customers who want\n              even more protection.\n            </p>\n\n            <p>\n              We publish our steel specifications\n              because you deserve to know exactly\n              what you're paying for.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- QUESTION 2 -->\n      <div class=\"faq-home-section__item\">\n\n        <button class=\"faq-home-section__question\"\n                type=\"button\"\n                id=\"faq-home-q2\"\n                aria-expanded=\"false\"\n                aria-controls=\"faq-home-a2\">\n\n          <span class=\"faq-home-section__question-text\">\n            What makes Sturdy's fire protection different?\n          </span>\n\n          <svg class=\"faq-home-section__icon\"\n               xmlns=\"http://www.w3.org/2000/svg\"\n               fill=\"none\"\n               viewBox=\"0 0 24 24\"\n               stroke=\"currentColor\"\n               stroke-width=\"2.5\"\n               aria-hidden=\"true\">\n            <path stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  d=\"M12 4.5v15m7.5-7.5h-15\"/>\n          </svg>\n        </button>\n\n        <div class=\"faq-home-section__answer\"\n             id=\"faq-home-a2\"\n             role=\"region\"\n             aria-labelledby=\"faq-home-q2\"\n             hidden>\n\n          <div class=\"faq-home-section__answer-inner\">\n            <p>\n              Instead of relying on conventional\n              gypsum-based fireboard, our fire-lined\n              safes use\n              <strong>2.5 inches of 2300°F\n              ceramic wool insulation.</strong>\n              It's a high-temperature insulation\n              material also used in industrial\n              heating applications.\n            </p>\n\n            <p>\n              Fireboard is commonly used in\n              fire-resistant building construction.\n              We prefer ceramic wool because it's\n              designed specifically for insulating\n              against extreme heat.\n            </p>\n\n            <p>\n              We don't ask you to take our word\n              for it. We share real-world results\n              from Sturdy safes and vault doors\n              that have survived actual house fires.\n            </p>\n\n            <p>\n              <a href=\"/pages/fireproof-safe\">\n                Learn about our fire protection\n              </a>\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- QUESTION 3 -->\n      <div class=\"faq-home-section__item\">\n\n        <button class=\"faq-home-section__question\"\n                type=\"button\"\n                id=\"faq-home-q3\"\n                aria-expanded=\"false\"\n                aria-controls=\"faq-home-a3\">\n\n          <span class=\"faq-home-section__question-text\">\n            What if I'm not satisfied with my safe?\n          </span>\n\n          <svg class=\"faq-home-section__icon\"\n               xmlns=\"http://www.w3.org/2000/svg\"\n               fill=\"none\"\n               viewBox=\"0 0 24 24\"\n               stroke=\"currentColor\"\n               stroke-width=\"2.5\"\n               aria-hidden=\"true\">\n            <path stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  d=\"M12 4.5v15m7.5-7.5h-15\"/>\n          </svg>\n        </button>\n\n        <div class=\"faq-home-section__answer\"\n             id=\"faq-home-a3\"\n             role=\"region\"\n             aria-labelledby=\"faq-home-q3\"\n             hidden>\n\n          <div class=\"faq-home-section__answer-inner\">\n            <p>\n              We offer a\n              <strong>30-day no-hassle return policy.</strong>\n              If you're not satisfied, you can\n              return your safe within 30 days\n              of delivery for a refund.\n              <strong>We even cover the return\n              shipping.</strong>\n            </p>\n\n            <p>\n              The safe must be returned in its\n              original condition with all\n              components included, in accordance\n              with our return policy.\n            </p>\n\n            <p>\n              We're confident in what we build,\n              and we want you to be confident\n              in your purchase.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- QUESTION 4 -->\n      <div class=\"faq-home-section__item\">\n\n        <button class=\"faq-home-section__question\"\n                type=\"button\"\n                id=\"faq-home-q4\"\n                aria-expanded=\"false\"\n                aria-controls=\"faq-home-a4\">\n\n          <span class=\"faq-home-section__question-text\">\n            What kind of warranty comes with a Sturdy Safe?\n          </span>\n\n          <svg class=\"faq-home-section__icon\"\n               xmlns=\"http://www.w3.org/2000/svg\"\n               fill=\"none\"\n               viewBox=\"0 0 24 24\"\n               stroke=\"currentColor\"\n               stroke-width=\"2.5\"\n               aria-hidden=\"true\">\n            <path stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  d=\"M12 4.5v15m7.5-7.5h-15\"/>\n          </svg>\n        </button>\n\n        <div class=\"faq-home-section__answer\"\n             id=\"faq-home-a4\"\n             role=\"region\"\n             aria-labelledby=\"faq-home-q4\"\n             hidden>\n\n          <div class=\"faq-home-section__answer-inner\">\n            <p>\n              Sturdy Safe backs its safes with\n              extensive lifetime warranty protection,\n              including coverage for qualifying\n              mechanical lock malfunctions and\n              fire damage.\n            </p>\n\n            <p>\n              Our warranty includes covered\n              locksmith services, shipping,\n              and replacement when applicable\n              under the warranty terms.\n            </p>\n\n            <p>\n              Optional attempted break-in\n              protection is also available.\n              See our complete warranty for\n              coverage details and conditions.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- QUESTION 5 -->\n      <div class=\"faq-home-section__item\">\n\n        <button class=\"faq-home-section__question\"\n                type=\"button\"\n                id=\"faq-home-q5\"\n                aria-expanded=\"false\"\n                aria-controls=\"faq-home-a5\">\n\n          <span class=\"faq-home-section__question-text\">\n            Are Sturdy Safes made in the USA?\n          </span>\n\n          <svg class=\"faq-home-section__icon\"\n               xmlns=\"http://www.w3.org/2000/svg\"\n               fill=\"none\"\n               viewBox=\"0 0 24 24\"\n               stroke=\"currentColor\"\n               stroke-width=\"2.5\"\n               aria-hidden=\"true\">\n            <path stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  d=\"M12 4.5v15m7.5-7.5h-15\"/>\n          </svg>\n        </button>\n\n        <div class=\"faq-home-section__answer\"\n             id=\"faq-home-a5\"\n             role=\"region\"\n             aria-labelledby=\"faq-home-q5\"\n             hidden>\n\n          <div class=\"faq-home-section__answer-inner\">\n            <p>\n              <strong>Yes. Sturdy Safes are\n              manufactured in Fresno, California,\n              using American steel.</strong>\n            </p>\n\n            <p>\n              We've been building safes since\n              1959. Our products are cut,\n              welded, and assembled at our\n              California manufacturing facility.\n            </p>\n\n            <p>\n              We believe in building a stronger\n              product, not cutting corners\n              to make a cheaper one.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- QUESTION 6 -->\n      <div class=\"faq-home-section__item\">\n\n        <button class=\"faq-home-section__question\"\n                type=\"button\"\n                id=\"faq-home-q6\"\n                aria-expanded=\"false\"\n                aria-controls=\"faq-home-a6\">\n\n          <span class=\"faq-home-section__question-text\">\n            Can I customize my safe?\n          </span>\n\n          <svg class=\"faq-home-section__icon\"\n               xmlns=\"http://www.w3.org/2000/svg\"\n               fill=\"none\"\n               viewBox=\"0 0 24 24\"\n               stroke=\"currentColor\"\n               stroke-width=\"2.5\"\n               aria-hidden=\"true\">\n            <path stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  d=\"M12 4.5v15m7.5-7.5h-15\"/>\n          </svg>\n        </button>\n\n        <div class=\"faq-home-section__answer\"\n             id=\"faq-home-a6\"\n             role=\"region\"\n             aria-labelledby=\"faq-home-q6\"\n             hidden>\n\n          <div class=\"faq-home-section__answer-inner\">\n            <p>\n              Absolutely. We offer custom sizes,\n              steel thickness upgrades,\n              interior configurations,\n              fire protection, lock options,\n              finishes, and more.\n            </p>\n\n            <p>\n              Whether you're looking for a\n              standard gun safe or something\n              built to your specific needs,\n              give us a call at\n              <a href=\"tel:18002620023\">\n                800-262-0023\n              </a>\n              to discuss your options.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- QUESTION 7 -->\n      <div class=\"faq-home-section__item\">\n\n        <button class=\"faq-home-section__question\"\n                type=\"button\"\n                id=\"faq-home-q7\"\n                aria-expanded=\"false\"\n                aria-controls=\"faq-home-a7\">\n\n          <span class=\"faq-home-section__question-text\">\n            How long does it take to receive my safe?\n          </span>\n\n          <svg class=\"faq-home-section__icon\"\n               xmlns=\"http://www.w3.org/2000/svg\"\n               fill=\"none\"\n               viewBox=\"0 0 24 24\"\n               stroke=\"currentColor\"\n               stroke-width=\"2.5\"\n               aria-hidden=\"true\">\n            <path stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                  d=\"M12 4.5v15m7.5-7.5h-15\"/>\n          </svg>\n        </button>\n\n        <div class=\"faq-home-section__answer\"\n             id=\"faq-home-a7\"\n             role=\"region\"\n             aria-labelledby=\"faq-home-q7\"\n             hidden>\n\n          <div class=\"faq-home-section__answer-inner\">\n            <p>\n              Most Sturdy Safes ship from our\n              Fresno, California facility within\n              <strong>2 to 6 weeks.</strong>\n              Actual production times can vary\n              depending on the model and\n              customization.\n            </p>\n\n            <p>\n              Safes are delivered by freight\n              carrier with curbside delivery.\n              If you need your safe moved\n              inside your home or business,\n              we can help you find a\n              professional safe mover.\n            </p>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"faq-home-section__footer\">\n      Still have questions?\n      Call us at\n      <a href=\"tel:18002620023\">800-262-0023</a>.\n      We're happy to help you choose the right safe.\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function () {\n  const root = document.getElementById('sturdy-home-faq');\n\n  if (!root) return;\n\n  const buttons = Array.from(\n    root.querySelectorAll('.faq-home-section__question')\n  );\n\n  buttons.forEach(function (button) {\n    button.addEventListener('click', function () {\n\n      const wasOpen =\n        button.getAttribute('aria-expanded') === 'true';\n\n      buttons.forEach(function (otherButton) {\n        otherButton.setAttribute('aria-expanded', 'false');\n\n        const panelId =\n          otherButton.getAttribute('aria-controls');\n\n        const panel = document.getElementById(panelId);\n\n        if (panel) {\n          panel.hidden = true;\n        }\n      });\n\n      if (!wasOpen) {\n        button.setAttribute('aria-expanded', 'true');\n\n        const panelId =\n          button.getAttribute('aria-controls');\n\n        const panel = document.getElementById(panelId);\n\n        if (panel) {\n          panel.hidden = false;\n        }\n      }\n    });\n  });\n})();\n</script>",
