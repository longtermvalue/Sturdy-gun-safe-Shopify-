    "custom_liquid_4NfpXP": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<!-- STURDY SAFE HOMEPAGE STEEL COMPARISON -->\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');\n\n.steel-proof {\n  background: #11151a;\n  color: #fff;\n  padding: 75px 22px;\n  width: 100vw;\n  position: relative;\n  left: 50%;\n  margin-left: -50vw;\n  box-sizing: border-box;\n  text-align: center;\n}\n\n.steel-proof * {\n  box-sizing: border-box;\n}\n\n.steel-proof__inner {\n  max-width: 1100px;\n  margin: auto;\n}\n\n.steel-proof__eyebrow {\n  font: 700 12px Helvetica, Arial, sans-serif;\n  letter-spacing: 2px;\n  color: #d9b84d;\n  text-transform: uppercase;\n  margin: 0 0 15px;\n}\n\n.steel-proof__title {\n  font-family: 'Anton', Impact, sans-serif;\n  font-size: clamp(34px, 5vw, 62px);\n  line-height: 1.1;\n  font-weight: 400;\n  color: #fff;\n  margin: 0 0 18px;\n}\n\n.steel-proof__intro {\n  max-width: 690px;\n  margin: 0 auto 35px;\n  font: 16px/1.7 Helvetica, Arial, sans-serif;\n  color: #c5c8cc;\n}\n\n.steel-proof__photo {\n  width: 100%;\n  display: block;\n  height: auto;\n  border-radius: 8px;\n  border: 1px solid #353b42;\n}\n\n.steel-proof__photo-caption {\n  font: 12px/1.5 Helvetica, Arial, sans-serif;\n  color: #aeb4bc;\n  margin: 12px 0 35px;\n}\n\n.steel-proof__comparison {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 15px;\n  text-align: left;\n}\n\n.steel-proof__card {\n  background: #22272e;\n  padding: 25px;\n  border: 1px solid #3b424b;\n  border-radius: 8px;\n}\n\n.steel-proof__card--sturdy {\n  border: 2px solid #d9b84d;\n  background: #252820;\n}\n\n.steel-proof__label {\n  display: block;\n  font: 700 12px Helvetica, Arial, sans-serif;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n  color: #d0d3d7;\n  margin-bottom: 15px;\n}\n\n.steel-proof__card--sturdy .steel-proof__label {\n  color: #e4c35c;\n}\n\n.steel-proof__value {\n  font: 400 clamp(36px, 5vw, 55px) 'Anton', Impact, sans-serif;\n  color: #fff;\n  line-height: 1;\n}\n\n.steel-proof__card--sturdy .steel-proof__value {\n  color: #e4c35c;\n}\n\n.steel-proof__description {\n  color: #c5c8cc;\n  font: 14px/1.6 Helvetica, Arial, sans-serif;\n  margin: 14px 0 0;\n}\n\n.steel-proof__bar-track {\n  width: 100%;\n  background: #3b424b;\n  height: 14px;\n  margin-top: 22px;\n  border-radius: 3px;\n  overflow: hidden;\n}\n\n.steel-proof__bar {\n  height: 100%;\n  background: #858b93;\n}\n\n.steel-proof__bar--thin {\n  width: 33.5%;\n}\n\n.steel-proof__bar--sturdy {\n  width: 100%;\n  background: #d9b84d;\n}\n\n.steel-proof__statement {\n  margin: 42px auto 12px;\n  color: #e4c35c;\n  font: 400 clamp(34px, 5vw, 52px) 'Anton', Impact, sans-serif;\n  line-height: 1.15;\n}\n\n.steel-proof__support {\n  max-width: 690px;\n  margin: 0 auto 25px;\n  color: #e0e0e0;\n  font: 16px/1.7 Helvetica, Arial, sans-serif;\n}\n\n.steel-proof__button {\n  display: inline-block;\n  background: #d9b84d;\n  color: #111 !important;\n  padding: 15px 27px;\n  border-radius: 4px;\n  text-decoration: none !important;\n  text-transform: uppercase;\n  letter-spacing: .5px;\n  font: 700 13px Helvetica, Arial, sans-serif;\n  transition: background .2s ease;\n}\n\n.steel-proof__button:hover {\n  background: #f0d477;\n}\n\n.steel-proof__disclaimer {\n  max-width: 720px;\n  margin: 22px auto 0;\n  color: #969da5;\n  font: 12px/1.6 Helvetica, Arial, sans-serif;\n}\n\n@media (max-width: 600px) {\n  .steel-proof {\n    padding: 48px 15px;\n  }\n\n  .steel-proof__intro {\n    font-size: 14px;\n    margin-bottom: 24px;\n  }\n\n  .steel-proof__comparison {\n    grid-template-columns: 1fr 1fr;\n    gap: 9px;\n  }\n\n  .steel-proof__card {\n    padding: 15px 12px;\n  }\n\n  .steel-proof__label {\n    font-size: 10px;\n    line-height: 1.4;\n    min-height: 42px;\n  }\n\n  .steel-proof__value {\n    font-size: clamp(27px, 8vw, 39px);\n  }\n\n  .steel-proof__description {\n    font-size: 12px;\n  }\n\n  .steel-proof__bar-track {\n    height: 11px;\n  }\n\n  .steel-proof__statement {\n    margin-top: 32px;\n  }\n\n  .steel-proof__support {\n    font-size: 14px;\n  }\n\n  .steel-proof__photo-caption {\n    font-size: 11px;\n  }\n}\n</style>\n\n<section class=\"steel-proof\">\n  <div class=\"steel-proof__inner\">\n\n    <p class=\"steel-proof__eyebrow\">\n      The Steel Doesn't Lie\n    </p>\n\n    <h2 class=\"steel-proof__title\">\n      THICKER STEEL. A TOUGHER SAFE.\n    </h2>\n\n    <p class=\"steel-proof__intro\">\n      Not all gun safes are built the same.\n      Before you trust a safe with your valuables,\n      take a closer look at the steel protecting them.\n    </p>\n\n    <!-- REPLACE WITH YOUR SHOPIFY IMAGE URL -->\n    <img\n      class=\"steel-proof__photo\"\n      src=\"https://cdn.shopify.com/s/files/1/1027/8593/files/D183C9D2-B17C-4D57-98B1-149BD9B2D34C.png?v=1791346085\"\n      alt=\"Actual steel thickness samples showing 14 gauge, 10 gauge, 4 gauge and 3/8 inch steel plate beside a tape measure.\"\n      loading=\"lazy\"\n    >\n\n    <p class=\"steel-proof__photo-caption\">\n      \n    </p>\n\n    <!-- SIDE-BY-SIDE STEEL COMPARISON -->\n    <div class=\"steel-proof__comparison\">\n\n      <div class=\"steel-proof__card\">\n        <span class=\"steel-proof__label\">\n          14-Gauge Steel Example\n        </span>\n\n        <div class=\"steel-proof__value\">\n          .075\"\n        </div>\n\n        <p class=\"steel-proof__description\">\n          Thinner sheet steel used in some gun safes.\n        </p>\n\n        <div class=\"steel-proof__bar-track\">\n          <div class=\"steel-proof__bar steel-proof__bar--thin\"></div>\n        </div>\n      </div>\n\n      <div class=\"steel-proof__card steel-proof__card--sturdy\">\n        <span class=\"steel-proof__label\">\n          STURDY HEAVY-DUTY\n        </span>\n\n        <div class=\"steel-proof__value\">\n          .224\"\n        </div>\n\n        <p class=\"steel-proof__description\">\n          4-gauge steel body. Nearly 1/4\" thick.\n        </p>\n\n        <div class=\"steel-proof__bar-track\">\n          <div class=\"steel-proof__bar steel-proof__bar--sturdy\"></div>\n        </div>\n      </div>\n\n    </div>\n\n    <h3 class=\"steel-proof__statement\">\n      NEARLY 3 TIMES THE STEEL THICKNESS.\n    </h3>\n\n    <p class=\"steel-proof__support\">\n      And that's just the body. Our Heavy-Duty\n      Most Popular package also features a\n      3/8\" solid steel door.\n      We believe a burglar should have to WORK\n      for what's inside.\n    </p>\n\n    <a\n      class=\"steel-proof__button\"\n      href=\"https://www.sturdysafe.com/pages/how-sturdy-safes-are-built\">\n      SEE HOW STURDY SAFES ARE BUILT\n    </a>\n\n    <p class=\"steel-proof__disclaimer\">\n      Competitors steel thickness varies by model. Compare fairly.\n    </p>\n\n  </div>\n</section>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
