      "blocks": {
        "custom_liquid_hYdg6P": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');\n\n  .truth-section {\n    background-color: #11151a;\n    padding: 80px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n    text-align: center;\n    overflow: hidden;\n  }\n\n  .truth-section__inner {\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n\n  .truth-section__eyebrow {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: #d9b84d;\n    margin: 0 0 16px;\n  }\n\n  .truth-section__title {\n    font-family: 'Anton', sans-serif;\n    font-size: 48px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: 0 0 48px;\n    letter-spacing: 0.01em;\n    line-height: 1.1;\n  }\n\n  /* Carousel wrapper */\n  .truth-carousel {\n    position: relative;\n  }\n\n  /* Visible carousel area */\n  .truth-carousel__viewport {\n    overflow: hidden;\n  }\n\n  /* Moving card track */\n  .truth-carousel__track {\n    display: flex;\n    gap: 20px;\n    overflow-x: auto;\n    scroll-behavior: smooth;\n    scroll-snap-type: x mandatory;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n    padding: 2px;\n  }\n\n  .truth-carousel__track::-webkit-scrollbar {\n    display: none;\n  }\n\n  .truth-section__card {\n    flex: 0 0 calc((100% - 40px) / 3);\n    scroll-snap-align: start;\n    box-sizing: border-box;\n    background-color: #1a1f27;\n    border: 1px solid #2a2f38;\n    border-radius: 10px;\n    padding: 28px;\n    text-align: left;\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n  }\n\n  .truth-section__card-header {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .truth-section__card-icon {\n    flex-shrink: 0;\n    width: 32px;\n    height: 32px;\n    background-color: rgba(217, 184, 77, 0.15);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .truth-section__card-icon svg {\n    width: 18px;\n    height: 18px;\n    color: #d9b84d;\n  }\n\n  .truth-section__card-title {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 15px;\n    font-weight: 700;\n    color: #ffffff;\n    margin: 0;\n    line-height: 1.4;\n  }\n\n  .truth-section__card-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    color: #aaaaaa;\n    line-height: 1.8;\n    margin: 0;\n  }\n\n  /* Arrow controls */\n  .truth-carousel__controls {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 18px;\n    margin-top: 30px;\n  }\n\n  .truth-carousel__arrow {\n    width: 42px;\n    height: 42px;\n    border: 1px solid #3a404a;\n    border-radius: 50%;\n    background-color: #1a1f27;\n    color: #d9b84d;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition:\n      background-color 0.2s ease,\n      border-color 0.2s ease,\n      opacity 0.2s ease;\n  }\n\n  .truth-carousel__arrow:hover {\n    background-color: #242a34;\n    border-color: #d9b84d;\n  }\n\n  .truth-carousel__arrow:disabled {\n    opacity: 0.35;\n    cursor: default;\n  }\n\n  .truth-carousel__arrow svg {\n    width: 19px;\n    height: 19px;\n  }\n\n  /* Navigation dots */\n  .truth-carousel__dots {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n  }\n\n  .truth-carousel__dot {\n    width: 8px;\n    height: 8px;\n    padding: 0;\n    border: 0;\n    border-radius: 50%;\n    background-color: #555b64;\n    cursor: pointer;\n    transition:\n      width 0.2s ease,\n      background-color 0.2s ease;\n  }\n\n  .truth-carousel__dot.is-active {\n    width: 22px;\n    border-radius: 10px;\n    background-color: #d9b84d;\n  }\n\n  @media (max-width: 900px) {\n    .truth-section__card {\n      flex-basis: calc((100% - 20px) / 2);\n    }\n  }\n\n  @media (max-width: 600px) {\n    .truth-section {\n      padding: 60px 20px;\n    }\n\n    .truth-section__title {\n      font-size: 32px;\n      margin-bottom: 36px;\n    }\n\n    .truth-section__card {\n      flex-basis: 100%;\n      padding: 24px;\n    }\n\n    .truth-section__card-text {\n      font-size: 14px;\n      line-height: 1.7;\n    }\n  }\n</style>\n\n<div class=\"truth-section\">\n  <div class=\"truth-section__inner\">\n\n    <p class=\"truth-section__eyebrow\">\n      Highly Recommended for a Reason\n    </p>\n\n    <h2 class=\"truth-section__title\">\n      What Sets Sturdy Apart?\n    </h2>\n\n    <div class=\"truth-carousel\">\n\n      <div class=\"truth-carousel__viewport\">\n        <div class=\"truth-carousel__track\">\n\n          <!-- Card 1 -->\n          <div class=\"truth-section__card\">\n            <div class=\"truth-section__card-header\">\n              <div class=\"truth-section__card-icon\">\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2.2\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    d=\"M12 3l7 3v6c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V6l7-3z\"\n                  />\n                </svg>\n              </div>\n\n              <h3 class=\"truth-section__card-title\">\n                More Steel for Your Dollar\n              </h3>\n            </div>\n\n            <p class=\"truth-section__card-text\">\n              Sturdy Gun Safes are built with thick, high-quality steel walls,\n              much stronger than what you’ll find in most safes at similar\n              prices. Thicker steel means more protection from power tools.\n            </p>\n          </div>\n\n          <!-- Card 2 -->\n          <div class=\"truth-section__card\">\n            <div class=\"truth-section__card-header\">\n              <div class=\"truth-section__card-icon\">\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2.2\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    d=\"M12 3l7 3v6c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V6l7-3z\"\n                  />\n                </svg>\n              </div>\n\n              <h3 class=\"truth-section__card-title\">\n                Real Fire Insulation\n              </h3>\n            </div>\n\n            <p class=\"truth-section__card-text\">\n              Sturdy Gun Safes use real fire insulation: 2.5 inches of\n              2300-degree ceramic wool—the same type used in ovens and kilns.\n              Our safes and vault doors have proven themselves in real house\n              fires.\n            </p>\n          </div>\n\n          <!-- Card 3 -->\n          <div class=\"truth-section__card\">\n            <div class=\"truth-section__card-header\">\n              <div class=\"truth-section__card-icon\">\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2.2\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    d=\"M12 3l7 3v6c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V6l7-3z\"\n                  />\n                </svg>\n              </div>\n\n              <h3 class=\"truth-section__card-title\">\n                Damage-Resistant Linkage\n              </h3>\n            </div>\n\n            <p class=\"truth-section__card-text\">\n              Our simple, heavy-duty linkage has fewer moving parts that can\n              fail. Even if the door is slammed with the deadbolts extended,\n              the mechanism is designed to resist damage and prevent costly\n              lockouts.\n            </p>\n          </div>\n\n          <!-- Card 4 -->\n          <div class=\"truth-section__card\">\n            <div class=\"truth-section__card-header\">\n              <div class=\"truth-section__card-icon\">\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2.2\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    d=\"M12 3l7 3v6c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V6l7-3z\"\n                  />\n                </svg>\n              </div>\n\n              <h3 class=\"truth-section__card-title\">\n                Unique Options\n              </h3>\n            </div>\n\n            <p class=\"truth-section__card-text\">\n              Only Sturdy offers mountable floor plates, security-enhancing\n              custom finishes, exterior fire blankets, personalized plaques,\n              customizable interior vinyl wraps, and padlockable door covers.\n            </p>\n          </div>\n\n          <!-- Card 5 -->\n          <div class=\"truth-section__card\">\n            <div class=\"truth-section__card-header\">\n              <div class=\"truth-section__card-icon\">\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2.2\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    d=\"M12 3l7 3v6c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V6l7-3z\"\n                  />\n                </svg>\n              </div>\n\n              <h3 class=\"truth-section__card-title\">\n                Superior Lifetime Warranty\n              </h3>\n            </div>\n\n            <p class=\"truth-section__card-text\">\n              Sturdy’s lifetime warranty covers shipping, locksmith entry,\n              repairs, and replacement for covered claims. Sargent & Greenleaf mechanical dial locks are covered as well.\n            </p>\n          </div>\n\n          <!-- Card 6 -->\n          <div class=\"truth-section__card\">\n            <div class=\"truth-section__card-header\">\n              <div class=\"truth-section__card-icon\">\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"2.2\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    d=\"M12 3l7 3v6c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V6l7-3z\"\n                  />\n                </svg>\n              </div>\n\n              <h3 class=\"truth-section__card-title\">\n                Nationwide Shipping Protection\n              </h3>\n            </div>\n\n            <p class=\"truth-section__card-text\">\n              We deliver throughout the U.S., help customers locate local\n              movers, and discreetly package every shipment. If freight damage\n              occurs, we’ll repair the safe or vault door however we reasonably\n              can and make it right.\n            </p>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- Carousel controls -->\n      <div class=\"truth-carousel__controls\">\n\n        <button\n          class=\"truth-carousel__arrow truth-carousel__arrow--previous\"\n          type=\"button\"\n          aria-label=\"View previous cards\"\n        >\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            fill=\"none\"\n            viewBox=\"0 0 24 24\"\n            stroke=\"currentColor\"\n            stroke-width=\"2.2\"\n          >\n            <path\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              d=\"M15 18l-6-6 6-6\"\n            />\n          </svg>\n        </button>\n\n        <div\n          class=\"truth-carousel__dots\"\n          aria-label=\"Carousel navigation\"\n        ></div>\n\n        <button\n          class=\"truth-carousel__arrow truth-carousel__arrow--next\"\n          type=\"button\"\n          aria-label=\"View next cards\"\n        >\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            fill=\"none\"\n            viewBox=\"0 0 24 24\"\n            stroke=\"currentColor\"\n            stroke-width=\"2.2\"\n          >\n            <path\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              d=\"M9 6l6 6-6 6\"\n            />\n          </svg>\n        </button>\n\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    document.querySelectorAll('.truth-carousel').forEach(function (carousel) {\n      const track = carousel.querySelector('.truth-carousel__track');\n      const cards = Array.from(\n        carousel.querySelectorAll('.truth-section__card')\n      );\n      const previousButton = carousel.querySelector(\n        '.truth-carousel__arrow--previous'\n      );\n      const nextButton = carousel.querySelector(\n        '.truth-carousel__arrow--next'\n      );\n      const dotsContainer = carousel.querySelector(\n        '.truth-carousel__dots'\n      );\n\n      if (!track || cards.length === 0) {\n        return;\n      }\n\n      let currentPage = 0;\n      let dots = [];\n\n      function getVisibleCardCount() {\n        if (window.innerWidth <= 600) {\n          return 1;\n        }\n\n        if (window.innerWidth <= 900) {\n          return 2;\n        }\n\n        return 3;\n      }\n\n      function getPageCount() {\n        return Math.ceil(cards.length / getVisibleCardCount());\n      }\n\n      function getCardStep() {\n        const firstCard = cards[0];\n        const trackStyles = window.getComputedStyle(track);\n        const gap = parseFloat(trackStyles.columnGap || trackStyles.gap) || 0;\n\n        return firstCard.getBoundingClientRect().width + gap;\n      }\n\n      function createDots() {\n        dotsContainer.innerHTML = '';\n        dots = [];\n\n        const pageCount = getPageCount();\n\n        for (let index = 0; index < pageCount; index += 1) {\n          const dot = document.createElement('button');\n\n          dot.type = 'button';\n          dot.className = 'truth-carousel__dot';\n          dot.setAttribute(\n            'aria-label',\n            'View carousel page ' + (index + 1)\n          );\n\n          dot.addEventListener('click', function () {\n            goToPage(index);\n          });\n\n          dotsContainer.appendChild(dot);\n          dots.push(dot);\n        }\n      }\n\n      function updateControls() {\n        const pageCount = getPageCount();\n\n        if (currentPage > pageCount - 1) {\n          currentPage = pageCount - 1;\n        }\n\n        previousButton.disabled = currentPage === 0;\n        nextButton.disabled = currentPage >= pageCount - 1;\n\n        dots.forEach(function (dot, index) {\n          const isActive = index === currentPage;\n\n          dot.classList.toggle('is-active', isActive);\n          dot.setAttribute(\n            'aria-current',\n            isActive ? 'true' : 'false'\n          );\n        });\n      }\n\n      function goToPage(pageIndex) {\n        const pageCount = getPageCount();\n        const visibleCardCount = getVisibleCardCount();\n\n        currentPage = Math.max(\n          0,\n          Math.min(pageIndex, pageCount - 1)\n        );\n\n        track.scrollTo({\n          left: getCardStep() * visibleCardCount * currentPage,\n          behavior: 'smooth'\n        });\n\n        updateControls();\n      }\n\n      previousButton.addEventListener('click', function () {\n        goToPage(currentPage - 1);\n      });\n\n      nextButton.addEventListener('click', function () {\n        goToPage(currentPage + 1);\n      });\n\n      let scrollTimer;\n\n      track.addEventListener('scroll', function () {\n        window.clearTimeout(scrollTimer);\n\n        scrollTimer = window.setTimeout(function () {\n          const visibleCardCount = getVisibleCardCount();\n          const pageWidth = getCardStep() * visibleCardCount;\n\n          currentPage = Math.round(track.scrollLeft / pageWidth);\n          updateControls();\n        }, 100);\n      });\n\n      let resizeTimer;\n\n      window.addEventListener('resize', function () {\n        window.clearTimeout(resizeTimer);\n\n        resizeTimer = window.setTimeout(function () {\n          currentPage = 0;\n          createDots();\n          track.scrollTo({\n            left: 0,\n            behavior: 'auto'\n          });\n          updateControls();\n        }, 150);\n      });\n\n      createDots();\n      updateControls();\n    });\n  });\n</script>"
          },
          "blocks": {}
        },
