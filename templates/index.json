    "custom_liquid_Qhw66p": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');\n\n  .social-proof-section {\n    background-color: #060b17;\n    padding: 80px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n    text-align: center;\n  }\n\n  .social-proof-section__inner {\n    max-width: 900px;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 32px;\n  }\n\n  .social-proof-section__eyebrow {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: #d4af37;\n    margin: 0;\n  }\n\n  .social-proof-section__stars {\n    display: flex;\n    gap: 6px;\n    margin-top: -16px;\n  }\n\n  .social-proof-section__stars svg {\n    width: 28px;\n    height: 28px;\n    fill: #d4af37;\n    color: #d4af37;\n  }\n\n  .social-proof-section__title {\n    font-family: 'Anton', sans-serif;\n    font-size: 48px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: -16px 0 0 0;\n    letter-spacing: 0.01em;\n    line-height: 1.1;\n  }\n\n  .social-proof-section__subtitle {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    color: #555555;\n    margin: -16px 0 0 0;\n  }\n\n  .social-proof-section__stats {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    background-color: #1a1f27;\n    border: 1px solid #2a2f38;\n    width: 100%;\n  }\n\n  .social-proof-section__stat {\n    padding: 24px 16px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .social-proof-section__stat:not(:last-child) {\n    border-right: 1px solid #2a2f38;\n  }\n\n  .social-proof-section__stat-value {\n    font-family: 'Anton', sans-serif;\n    font-size: 28px;\n    color: #d4af37;\n    letter-spacing: 0.02em;\n    line-height: 1;\n  }\n\n  .social-proof-section__stat-label {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: #555555;\n  }\n\n  .social-proof-section__features {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-wrap: wrap;\n    gap: 8px 32px;\n  }\n\n  .social-proof-section__feature {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    color: #aaaaaa;\n  }\n\n  .social-proof-section__feature svg {\n    width: 14px;\n    height: 14px;\n    color: #d4af37;\n    flex-shrink: 0;\n  }\n\n  @media (max-width: 768px) {\n    .social-proof-section__title {\n      font-size: 32px;\n    }\n\n    .social-proof-section__stats {\n      grid-template-columns: repeat(2, 1fr);\n    }\n\n    .social-proof-section__stat:nth-child(2) {\n      border-right: none;\n    }\n\n    .social-proof-section__stat:nth-child(1),\n    .social-proof-section__stat:nth-child(2) {\n      border-bottom: 1px solid #2a2f38;\n    }\n\n    .social-proof-section__features {\n      flex-direction: column;\n      gap: 12px;\n    }\n  }\n</style>\n\n<div class=\"social-proof-section\">\n  <div class=\"social-proof-section__inner\">\n\n    <p class=\"social-proof-section__eyebrow\"> the general consensus of</p>\n\n    <div class=\"social-proof-section__stars\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n    </div>\n\n    <h2 class=\"social-proof-section__title\"> Thousands Of Customers </h2>\n    <p class=\"social-proof-section__subtitle\">Reviews from Google and verified customers</p>\n\n    <div class=\"social-proof-section__stats\">\n      <div class=\"social-proof-section__stat\">\n        <span class=\"social-proof-section__stat-value\">4.99</span>\n        <span class=\"social-proof-section__stat-label\">Average Rating</span>\n      </div>\n      <div class=\"social-proof-section__stat\">\n        <span class=\"social-proof-section__stat-value\">65+</span>\n        <span class=\"social-proof-section__stat-label\">Years in Business</span>\n      </div>\n      <div class=\"social-proof-section__stat\">\n        <span class=\"social-proof-section__stat-value\">100%</span>\n        <span class=\"social-proof-section__stat-label\">American-Made</span>\n      </div>\n      <div class=\"social-proof-section__stat\">\n        <span class=\"social-proof-section__stat-value\">0</span>\n        <span class=\"social-proof-section__stat-label\">Pressure</span>\n      </div>\n    </div>\n\n    <div class=\"social-proof-section__features\">\n      <div class=\"social-proof-section__feature\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"/>\n        </svg>\n        Backed by a lifetime warranty\n      </div>\n      <div class=\"social-proof-section__feature\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"/>\n        </svg>\n        Built-to-order in Fresno, CA\n      </div>\n    </div>\n\n  </div>\n</div>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
