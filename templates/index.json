        "custom_liquid": "<style>\n  .trust-bar {\n    background-color: #060b17;\n    padding: 36px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .trust-bar__inner {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: 24px;\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  .trust-bar__item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    gap: 10px;\n    cursor: default;\n    transition: transform 0.25s ease;\n  }\n\n  .trust-bar__item:hover {\n    transform: scale(1.1);\n  }\n\n  .trust-bar__item svg {\n    width: 28px;\n    height: 28px;\n    color: #d4af37;\n    flex-shrink: 0;\n  }\n\n  .trust-bar__item span {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 300;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: #aaaaaa;\n    white-space: normal;\n    line-height: 1.5;\n    max-width: 190px;\n  }\n\n  @media (max-width: 900px) {\n    .trust-bar__inner {\n      grid-template-columns: repeat(3, 1fr);\n      gap: 28px 16px;\n    }\n\n    .trust-bar__item span {\n      font-size: 10px;\n      max-width: 170px;\n    }\n  }\n\n  @media (max-width: 600px) {\n    .trust-bar__inner {\n      grid-template-columns: 1fr 1fr;\n      gap: 28px 16px;\n    }\n  }\n\n  @media (max-width: 400px) {\n    .trust-bar__inner {\n      grid-template-columns: 1fr;\n    }\n\n    .trust-bar__item span {\n      max-width: 200px;\n    }\n  }\n</style>\n\n<div class=\"trust-bar\">\n  <div class=\"trust-bar__inner\">\n\n    <div class=\"trust-bar__item\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-1.5 6h13L17 13M9 21a1 1 0 100-2 1 1 0 000 2zm10 0a1 1 0 100-2 1 1 0 00