        "custom_liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');\n\n  .returns-bar {\n    background-color: #f2f2f2;\n    padding: 20px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n    text-align: center;\n  }\n\n  .returns-bar__inner {\n    max-width: 900px;\n    margin: 0 auto;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    flex-wrap: wrap;\n  }\n\n  .returns-bar__main {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    cursor: default;\n    transition: transform 0.25s ease;\n  }\n\n  .returns-bar__main:hover {\n    transform: scale(1.08);\n  }\n\n  .returns-bar__icon {\n    width: 20px;\n    height: 20px;\n    color: #11151a;\n    flex-shrink: 0;\n  }\n\n  .returns-bar__text {\n    font-family: 'Anton', sans-serif;\n    font-size: 18px;\n    font-weight: 400;\n    color: #11151a;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n  }\n\n  .returns-bar__divider {\n    width: 1px;\n    height: 18px;\n    background-color: rgba(0,0,0,0.15);\n    flex-shrink: 0;\n  }\n\n  .returns-bar__sub {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    color: rgba(0,0,0,0.5);\n    font-weight: 500;\n  }\n\n  @media (max-width: 600px) {\n    .returns-bar__divider {\n      display: none;\n    }\n\n    .returns-bar__inner {\n      gap: 6px;\n    }\n\n    .returns-bar__text {\n      font-size: 15px;\n    }\n\n    .returns-bar__sub {\n      font-size: 12px;\n      width: 100%;\n    }\n  }\n</style>\n\n<div class=\"returns-bar\">\n  <div class=\"returns-bar__inner\">\n    <div class=\"returns-bar__main\">\n      <svg class=\"returns-bar__icon\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12.75 11.25 15 15 9.75M21 12a