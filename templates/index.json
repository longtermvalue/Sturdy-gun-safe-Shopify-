    "custom_liquid_nn6CD8": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom Liquid- what the safe",
      "settings": {
        "custom_liquid": "<!-- STURDY SAFE - COMPACT PHOTO CARDS -->\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');\n\n.sturdy-truth {\n  background: #11151a;\n  padding: 48px 20px;\n  width: 100vw;\n  position: relative;\n  left: 50%;\n  margin-left: -50vw;\n  box-sizing: border-box;\n  text-align: center;\n}\n\n.sturdy-truth * {\n  box-sizing: border-box;\n}\n\n.sturdy-truth__inner {\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n.sturdy-truth__eyebrow {\n  color: #d9b84d;\n  font: 700 11px Helvetica, Arial, sans-serif;\n  letter-spacing: 1.6px;\n  text-transform: uppercase;\n  margin: 0 0 12px;\n}\n\n.sturdy-truth__title {\n  color: #fff;\n  font: 400 clamp(28px, 4vw, 42px)/1.15\n    'Anton', Impact, sans-serif;\n  margin: 0 0 26px;\n}\n\n.sturdy-truth__track {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 16px;\n  text-align: left;\n}\n\n.sturdy-truth__card {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  background: #20252c;\n  border: 1px solid #343b44;\n  border-radius: 8px;\n}\n\n.sturdy-truth__image-wrap {\n  width: 100%;\n  height: 170px;\n  overflow: hidden;\n  background: #15191e;\n  border-bottom: 3px solid #d9b84d;\n}\n\n.sturdy-truth__image {\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n}\n\n/* Per-photo framing adjustments */\n.sturdy-truth__image--construction {\n  object-position: 50% 50%;\n}\n\n.sturdy-truth__image--fire {\n  object-position: 50% 45%;\n}\n\n.sturdy-truth__image--linkage {\n  object-position: 50% 50%;\n}\n\n.sturdy-truth__body {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  padding: 20px;\n}\n\n.sturdy-truth__number {\n  color: #d9b84d;\n  font: 700 11px Helvetica, Arial, sans-serif;\n  letter-spacing: 1px;\n  margin-bottom: 12px;\n}\n\n.sturdy-truth__card-title {\n  color: #fff;\n  font: 700 16px/1.35 Helvetica, Arial, sans-serif;\n  margin: 0 0 11px;\n}\n\n.sturdy-truth__description {\n  color: #c8cbd0;\n  font: 14px/1.6 Helvetica, Arial, sans-serif;\n  margin: 0 0 18px;\n}\n\n.sturdy-truth__link {\n  display: inline-block;\n  align-self: flex-start;\n  margin-top: auto;\n  color: #e5c65f !important;\n  font: 700 12px Helvetica, Arial, sans-serif;\n  text-decoration: underline !important;\n  text-underline-offset: 3px;\n}\n\n.sturdy-truth__link:hover {\n  color: #fff !important;\n}\n\n.sturdy-truth__hint {\n  display: none;\n}\n\n@media (max-width: 700px) {\n  .sturdy-truth {\n    padding: 36px 0;\n  }\n\n  .sturdy-truth__eyebrow {\n    padding: 0 16px;\n  }\n\n  .sturdy-truth__title {\n    padding: 0 18px;\n    margin-bottom: 20px;\n  }\n\n  .sturdy-truth__track {\n    display: flex;\n    gap: 12px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    scroll-padding-inline: 18px;\n    padding: 0 18px 12px;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n  }\n\n  .sturdy-truth__track::-webkit-scrollbar {\n    display: none;\n  }\n\n  .sturdy-truth__card {\n    flex: 0 0 82%;\n    max-width: 330px;\n    scroll-snap-align: start;\n  }\n\n  .sturdy-truth__image-wrap {\n    height: 160px;\n  }\n\n  .sturdy-truth__body {\n    padding: 18px;\n  }\n\n  .sturdy-truth__hint {\n    display: block;\n    color: #aeb4bc;\n    font: 12px Helvetica, Arial, sans-serif;\n    margin: 10px 0 0;\n  }\n}\n</style>\n\n<section class=\"sturdy-truth\">\n  <div class=\"sturdy-truth__inner\">\n\n    <p class=\"sturdy-truth__eyebrow\">\n      NO GIMMICKS. JUST REAL PROTECTION.\n    </p>\n\n    <h2 class=\"sturdy-truth__title\">\n      BUILT DIFFERENT. FOR A REASON.\n    </h2>\n\n    <div class=\"sturdy-truth__track\"\n      aria-label=\"Sturdy Safe construction advantages\">\n\n      <!-- CARD 1: CONSTRUCTION -->\n      <article class=\"sturdy-truth__card\">\n        <div class=\"sturdy-truth__image-wrap\">\n          <img\n            class=\"sturdy-truth__image sturdy-truth__image--construction\"\n            src=\"https://cdn.shopify.com/s/files/1/1027/8593/files/IMG_5103.jpg?v=1790704282\"\n            alt=\"Close-up of Sturdy Safe steel door construction with tape measure\"\n            loading=\"lazy\">\n        </div>\n\n        <div class=\"sturdy-truth__body\">\n          <span class=\"sturdy-truth__number\">\n            01 / SECURITY\n          </span>\n\n          <h3 class=\"sturdy-truth__card-title\">\n            STRONGER WHERE IT COUNTS\n          </h3>\n\n          <p class=\"sturdy-truth__description\">\n            Heavy steel, reinforced construction,\n            and supported deadbolts designed to\n            resist forced entry.\n          </p>\n\n          <a class=\"sturdy-truth__link\"\n            href=\"https://www.sturdysafe.com/pages/how-sturdy-safes-are-built\">\n            See Our Construction\n          </a>\n        </div>\n      </article>\n\n      <!-- CARD 2: FIRE PROTECTION -->\n      <article class=\"sturdy-truth__card\">\n        <div class=\"sturdy-truth__image-wrap\">\n          <img\n            class=\"sturdy-truth__image sturdy-truth__image--fire\"\n            src=\"https://cdn.shopify.com/s/files/1/1027/8593/files/firegunsafeinsulationmaterial.png?v=1791396526\"\n            alt=\"Sturdy Safe fire insulation material comparison showing body, door, top and bottom insulation\"\n            loading=\"lazy\">\n        </div>\n\n        <div class=\"sturdy-truth__body\">\n          <span class=\"sturdy-truth__number\">\n            02 / FIRE PROTECTION\n          </span>\n\n          <h3 class=\"sturdy-truth__card-title\">\n            NO MADE-UP FIRE RATINGS\n          </h3>\n\n          <p class=\"sturdy-truth__description\">\n            High-temperature ceramic wool insulation,\n            published materials, and real-world fire\n            evidence. No inflated fire-rating promises.\n          </p>\n\n          <a class=\"sturdy-truth__link\"\n            href=\"https://www.sturdysafe.com/pages/fireproof-safe\">\n            See Our Fire Protection\n          </a>\n        </div>\n      </article>\n\n      <!-- CARD 3: LINKAGE -->\n      <article class=\"sturdy-truth__card\">\n        <div class=\"sturdy-truth__image-wrap\">\n          <img\n            class=\"sturdy-truth__image sturdy-truth__image--linkage\"\n            src=\"https://cdn.shopify.com/s/files/1/1027/8593/files/IMG_6777.jpg?v=1791403959\"\n            alt=\"Sturdy Safe locking linkage and deadbolt mechanism\"\n            loading=\"lazy\">\n        </div>\n\n        <div class=\"sturdy-truth__body\">\n          <span class=\"sturdy-truth__number\">\n            03 / ENGINEERING\n          </span>\n\n          <h3 class=\"sturdy-truth__card-title\">\n            MORE BOLTS ≠ MORE SECURITY\n          </h3>\n\n          <p class=\"sturdy-truth__description\">\n            Fully welded linkage and supported\n            deadbolts. Built for strength,\n            not just appearance.\n          </p>\n\n          <a class=\"sturdy-truth__link\"\n            href=\"https://www.sturdysafe.com/pages/sturdy-gun-safes-linkage-design\">\n            See Our Linkage Design\n          </a>\n        </div>\n      </article>\n\n    </div>\n\n    <p class=\"sturdy-truth__hint\">\n      Swipe to see more →\n    </p>\n\n  </div>\n</section>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
