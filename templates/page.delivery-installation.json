max-width: 768px) {\n    .installation-section__inner {\n      grid-template-columns: 1fr;\n      gap: 40px;\n    }\n\n    .installation-section__title {\n      font-size: 24px;\n    }\n\n    .installation-section__text,\n    .installation-section__step-text {\n      font-size: 13px;\n    }\n  }\n<\/style>\n\n<div class=\"installation-section\">\n  <div class=\"installation-section__inner\">\n\n    <div>\n      <h2 class=\"installation-section__title\">In-Home Installation<\/h2>\n      <p class=\"installation-section__text\">Need the safe moved inside? We can connect you with trusted local movers who specialize in heavy safe delivery and placement. They'll handle stairs, tight hallways, and final positioning.<\/p>\n    <\/div>\n\n    <div>\n      <h2 class=\"installation-section__title\">Receiving Your Delivery<\/h2>\n      <p class=\"installation-section__text\">When your safe arrives:<\/p>\n      <div class=\"installation-section__steps\">\n\n        <div class=\"installation-section__step\">\n          <div class=\"installation-section__step-num\">1<\/div>\n          <span class=\"installation-section__step-text\">Inspect the packaging for visible damage before signing<\/span>\n        <\/div>\n\n        <div class=\"installation-section__step\">\n          <div class=\"installation-section__step-num\">2<\/div>\n          <span class=\"installation-section__step-text\">Note any damage on the delivery receipt<\/span>\n        <\/div>\n\n        <div class=\"installation-section__step\">\n          <div class=\"installation-section__step-num\">3<\/div>\n          <span class=\"installation-section__step-text\">Contact us immediately at 800-262-0023 if there are any issues<\/span>\n        <\/div>\n\n        <div class=\"installation-section__step\">\n          <div class=\"installation-section__step-num\">4<\/div>\n          <span class=\"installation-section__step-text\">Keep the packaging until you've confirmed the safe is in perfect condition<\/span>\n        <\/div>\n\n      <\/div>\n    <\/div>\n\n  <\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_iW3CLJ":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"hero_YgqeAx":{"type":"hero","blocks":{"text_bcNkTk":{"type":"text","settings":{"text":"<h2>Questions About Delivery?<\/h2>","width":"fit-content","max_width":"narrow","alignment":"left","type_preset":"h1","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_3gt6dJ":{"type":"text","settings":{"text":"<p>Call 800-262-0023 to discuss delivery logistics, get a quote that includes delivery, or find a mover in your area.<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"button_C6ypc9":{"type":"button","name":"t:names.button","settings":{"label":"Call 800-262-