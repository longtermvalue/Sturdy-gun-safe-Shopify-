    "custom_liquid_6iFWkQ": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Anton&display=swap');\n\n  .installation-section {\n    background-color: #11151a;\n    padding: 60px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .installation-section__inner {\n    max-width: 900px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 60px;\n  }\n\n  .installation-section__title {\n    font-family: 'Anton', sans-serif;\n    font-size: 28px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: 0 0 16px 0;\n    letter-spacing: 0.01em;\n  }\n\n  .installation-section__text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: #aaaaaa;\n    line-height: 1.8;\n    margin: 0;\n  }\n\n  .installation-section__steps {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n    margin-top: 24px;\n  }\n\n  .installation-section__step {\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n  }\n\n  .installation-section__step-num {\n    flex-shrink: 0;\n    width: 26px;\n    height: 26px;\n    background-color: #d9b84d;\n    border-radius: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    color: #11151a;\n    margin-top: 1px;\n  }\n\n  .installation-section__step-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: #cccccc;\n    line-height: 1.7;\n  }\n\n  @media (max-width: 768px) {\n    .installation-section__inner {\n      grid-template-columns: 1fr;\n      gap: 40px;\n    }\n\n    .installation-section__title {\n      font-size: 24px;\n    }\n\n    .installation-section__text,\n    .installation-section__step-text {\n      font-size: 13px;\n    }\n  }\n</style>\n\n<div class=\"installation-section\">\n  <div class=\"installation-section__inner\">\n\n    <div>\n      <h2 class=\"installation-section__title\">Move it yourself Tips</h2>\n      <p class=\"installation-section__text\"> Getting the right moving equipment depends on the size safe you get. Look up the following to rent or buy: <br>\n* Rolling Rod Method <br>\n* Hydraulic Moving Dollies (Rol-A-Lift) and Johnson Bar <br> \n* Moving Men Sliding Disks <br>\n* 2 Large Plywood Boards For Moving Over Tile <br>\n* Rolling Rod Method <br>\n\n</p> \n    </div>\n\n    <div>\n      <h2 class=\"installation-section__title\">Receiving Your Delivery</h2>\n      <p class=\"installation-section__text\">When your safe arrives:</p>\n      <div class=\"installation-section__steps\">\n\n        <div class=\"installation-section__step\">\n          <div class=\"installation-section__step-num\">1</div>\n          <span class=\"installation-section__step-text\">Inspect the packaging for visible damage before signing</span>\n        </div>\n\n        <div class=\"installation-section__step\">\n          <div class=\"installation-section__step-num\">2</div>\n          <span class=\"installation-section__step-text\">Note any damage on the delivery receipt</span>\n        </div>\n\n        <div class=\"installation-section__step\">\n          <div class=\"installation-section__step-num\">3</div>\n          <span class=\"installation-section__step-text\">Contact us immediately at 800-262-0023 if there are any issues</span>\n        </div>\n\n        <div class=\"installation-section__step\">\n          <div class=\"installation-section__step-num\">4</div>\n          <span class=\"installation-section__step-text\">Keep the packaging until you've confirmed the safe is in perfect condition</span>\n        </div>\n\n      </div>\n    </div>\n\n  </div>\n</div>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
