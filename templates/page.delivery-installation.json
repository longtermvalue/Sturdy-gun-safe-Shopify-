n":false,"reflection_opacity":75,"padding-block-start":40,"padding-block-end":40}},"custom_liquid_PNY8zR":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_QxNRKj":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Anton&display=swap');\n\n  .delivery-section {\n    background-color: #11151a;\n    padding: 60px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .delivery-section__inner {\n    max-width: 900px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .delivery-section__title {\n    font-family: 'Anton', sans-serif;\n    font-size: 32px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: 0 0 16px 0;\n    letter-spacing: 0.01em;\n  }\n\n  .delivery-section__subtitle {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 15px;\n    color: #aaaaaa;\n    line-height: 1.7;\n    margin: 0 auto 36px auto;\n  }\n\n  .delivery-section__list {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .delivery-section__item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    gap: 12px;\n    background-color: #1a1f27;\n    border: 1px solid #2a2f38;\n    border-radius: 0;\n    padding: 28px 24px;\n  }\n\n  .delivery-section__icon {\n    flex-shrink: 0;\n    width: 22px;\n    height: 22px;\n    color: #d9b84d;\n  }\n\n  .delivery-section__item-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: #cccccc;\n    line-height: 1.7;\n    margin: 0;\n  }\n\n  .delivery-section__item-text strong {\n    color: #ffffff;\n    font-weight: 700;\n  }\n\n  @media (max-width: 768px) {\n    .delivery-section__title {\n      font-size: 26px;\n    }\n\n    .delivery-section__subtitle {\n      font-size: 14px;\n    }\n\n    .delivery-section__item {\n      padding: 20px;\n    }\n\n    .delivery-section__item-text {\n      font-size: 13px;\n    }\n  }\n<\/style>\n\n<div class=\"delivery-section\">\n  <div class=\"delivery-section__inner\">\n\n    <h2 class=\"delivery-section__title\">How Delivery Works<\/h2>\n    <p class=\"delivery-section__subtitle\">Every Sturdy Safe ships from our Fresno, California facility to anywhere in the continental United States. Here's what to expect:<\/p>\n\n    <div class=\"delivery-section__list\">\n\n      <div class=\"delivery-section__item\">\n        <svg class=\"delivery-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n        <\/svg>\n        <p class=\"delivery-section__item-text\"><strong>Curbside Delivery:<\/strong> Your safe arrives on a pallet via freight carrier, delivered to your driveway or garage. The freight driver uses a pallet jack to move it off the truck.<\/p>\n      <\/div>\n\n      <div class=\"delivery-section__item\">\n        <svg class=\"delivery-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n        <\/svg>\n        <p class=\"delivery-section__item-text\"><strong>Discreet Shipping:<\/strong> All safes ship in plain, unmarked packaging. No brand names or product descriptions on the outside. Your neighbors won't know what's being delivered.<\/p>\n      <\/div>\n\n      <div class=\"delivery-section__item\">\n        <svg class=\"delivery-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n        <\/svg>\n        <p class=\"delivery-section__item-text\"><strong>Timeline:<\/strong> Most safes ship within 2–4 weeks from order placement. You'll receive tracking information and delivery instructions once your safe ships.<\/p>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"main":{"type":"main-page","blocks":{"heading":{"type":"text","name":"Title","settings":{"text":"<h1>{{ closest.page.title }}<\/h1>","width":"100%","max_width":"normal","alignment":"left","type_preset":"h2","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"page-content":{"type":"page-content","settings":{},"blocks":{}}},"block_order":["heading","page-content"],"disabled":true,"settings":{"content_direction":"column","gap":32,"color_scheme":"","padding-block-start":60,"padding-block-end":60}},"custom_liquid_3YegaV":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n