nd-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_QTVPig":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Anton&display=swap');\n\n  .faq-essential-section {\n    background-color: #11151a;\n    padding: 60px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .faq-essential-section__inner {\n    max-width: 900px;\n    margin: 0 auto;\n  }\n\n  .faq-essential-section__title {\n    font-family: 'Anton', sans-serif;\n    font-size: 36px;\n    font-weight: 400;\n    color: #d4af37;\n    margin: 0 0 40px 0;\n    letter-spacing: 0.01em;\n  }\n\n  .faq-essential-section__list {\n    display: flex;\n    flex-direction: column;\n    border-top: 1px solid #2a2f38;\n  }\n\n  .faq-essential-section__item {\n    border-bottom: 1px solid #2a2f38;\n  }\n\n  .faq-essential-section__question {\n    width: 100%;\n    background: none;\n    border: none;\n    padding: 24px 0;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    cursor: pointer;\n    text-align: left;\n  }\n\n  .faq-essential-section__question-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 15px;\n    font-weight: 700;\n    color: #ffffff;\n    line-height: 1.4;\n  }\n\n  .faq-essential-section__icon {\n    flex-shrink: 0;\n    width: 20px;\n    height: 20px;\n    color: #d4af37;\n    transition: transform 0.3s ease;\n  }\n\n  .faq-essential-section__item.is-open .faq-essential-section__icon {\n    transform: rotate(45deg);\n  }\n\n  .faq-essential-section__answer {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.4s ease;\n  }\n\n  .faq-essential-section__item.is-open .faq-essential-section__answer {\n    max-height: 600px;\n  }\n\n  .faq-essential-section__answer-inner {\n    padding: 0 0 24px 0;\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: #aaaaaa;\n    line-height: 1.8;\n    max-width: 780px;\n  }\n\n  @media (max-width: 768px) {\n    .faq-essential-section__title {\n      font-size: 26px;\n    }\n\n    .faq-essential-section__question-text {\n      font-size: 14px;\n    }\n\n    .faq-essential-section__answer-inner {\n      font-size: 13px;\n    }\n\n    .faq-essential-section__question {\n      padding: 20px 0;\n    }\n  }\n<\/style>\n\n<div class=\"faq-essential-section\">\n  <div class=\"faq-essential-section__inner\">\n\n    <h2 class=\"faq-essential-section__title\">Frequently Asked Questions<\/h2>\n\n    <div class=\"faq-essential-section__list\">\n\n      <div class=\"faq-essential-section__item\">\n        <button class=\"faq-essential-section__question\">\n          <span class=\"faq-essential-section__question-text\">How does the Essential line differ from Heavy Duty?<\/span>\n          <svg class=\"faq-essential-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-essential-section__answer\">\n          <p class=\"faq-essential-section__answer-inner\">The Essential line uses 3\/16-inch (7 gauge) body steel versus the Heavy Duty's .22-inch (4 gauge). The door plate is also 3\/16-inch rather than 3\/8-inch + reinforcing frame. Both lines use S&G locks and carry the same lifetime warranty.<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"faq-essential-section__item\">\n        <button class=\"faq-essential-section__question\">\n          <span class=\"faq-essential-section__question-text\">What lock comes with an Essential safe?<\/span>\n          <svg class=\"faq-essential-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-essential-section__answer\">\n          <p class=\"faq-essential-section__answer-inner\">All Essential safes use Sargent & Greenleaf locks — mechanical dial or electronic keypad. Both are covered under warranty.<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"faq-essential-section__item\">\n        <button class=\"faq-essential-section__question\">\n          <span class=\"faq-essential-section__question-text\">Can I upgrade to fire insulation on the Essential line?<\/span>\n          <svg class=\"faq-essential-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-essential-section__answer\">\n          <p class=\"faq-essential-section__answer-inner\">Yes. The same 2.5-inch ceramic wool rated to 2,300°F used in the Heavy Duty line is available as an upgrade on Essential safes.<\/p>\n        <\/div>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\n  document.querySelectorAll('.faq-essential-section__question').forEach(button => {\n    button.addEventListener('click', () => {\n      const item = button.closest('.faq-essential-section__item');\n      const isOpen = item.classList.contains('is-open');\n\n      document.querySelectorAll('.faq-essential-section__item.is-open').forEach(open => {\n        open.classList.remove('is-open');\n      });\n\n      if (!isOpen) {\n        item.classList.add('is-open');\n      }\n    });\n  });\n<\/script>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}}},"order":["hero_668Nnr","section_nBmPwy","main","custom_liquid_VBf8jR","custom_liquid_LxfCNk","custom_liquid_WrECRD","product_list_F4JYHy","custom_liquid_eMWcMY","custom_liquid_QTVPig"]}