ire-temp-section__card--sturdy .fire-temp-section__card-desc {\n    color: #aaaaaa;\n  }\n\n  .fire-temp-section__vs {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0 24px;\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    color: #444444;\n    text-transform: uppercase;\n  }\n\n  .fire-temp-section__note {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    color: #d4af37;\n    font-weight: 600;\n  }\n\n  @media (max-width: 768px) {\n    .fire-temp-section__cards {\n      grid-template-columns: 1fr;\n    }\n\n    .fire-temp-section__vs {\n      padding: 16px 0;\n    }\n\n    .fire-temp-section__title {\n      font-size: 26px;\n    }\n\n    .fire-temp-section__card-temp {\n      font-size: 40px;\n    }\n  }\n<\/style>\n\n<div class=\"fire-temp-section\">\n  <div class=\"fire-temp-section__inner\">\n\n    <p class=\"fire-temp-section__eyebrow\">Temperature Ratings<\/p>\n    <h2 class=\"fire-temp-section__title\">Drywall vs. ceramic wool<\/h2>\n    <p class=\"fire-temp-section__subtitle\">At what temperature does each material fail — on a 2,300°F scale.<\/p>\n\n    <div class=\"fire-temp-section__cards\">\n\n      <div class=\"fire-temp-section__card\">\n        <span class=\"fire-temp-section__card-temp\">~1,000°<\/span>\n        <span class=\"fire-temp-section__card-badge\">Failure Point<\/span>\n        <span class=\"fire-temp-section__card-name\">Drywall<\/span>\n        <span class=\"fire-temp-section__card-desc\">Cracks, crumbles, steams<\/span>\n      <\/div>\n\n      <div class=\"fire-temp-section__vs\">vs<\/div>\n\n      <div class=\"fire-temp-section__card fire-temp-section__card--sturdy\">\n        <span class=\"fire-temp-section__card-temp\">2,300°<\/span>\n        <span class=\"fire-temp-section__card-badge\">Rated Temp<\/span>\n        <span class=\"fire-temp-section__card-name\">Ceramic Wool<\/span>\n        <span