 #11151a;\n    padding: 80px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .fire-drywall-section__inner {\n    max-width: 900px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 60px;\n    align-items: start;\n  }\n\n  .fire-drywall-section__eyebrow {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: #d4af37;\n    margin: 0 0 16px 0;\n  }\n\n  .fire-drywall-section__title {\n    font-family: 'Anton', sans-serif;\n    font-size: 32px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: 0 0 20px 0;\n    letter-spacing: 0.01em;\n    line-height: 1.2;\n  }\n\n  .fire-drywall-section__body {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: #aaaaaa;\n    line-height: 1.8;\n    margin: 0 0 20px 0;\n  }\n\n  .fire-drywall-section__cards {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .fire-drywall-section__card {\n    background-color: #1a1f27;\n    border: 1px solid #2a2f38;\n    border-left: 3px solid #444444;\n    padding: 20px 24px;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  .fire-drywall-section__card--bad {\n    border-left-color: #555555;\n  }\n\n  .fire-drywall-section__card--good {\n    border-left-color: #d4af37;\n  }\n\n  .fire-drywall-section__card-label {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #555555;\n  }\n\n  .fire-drywall-section__card--good .fire-drywall-section__card-label {\n    color: #d4af37;\n  }\n\n  .fire-drywall-section__card-tags {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n  }\n\n  .fire-drywall-section__tag {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 600;\n    padding: 4px 10px;\n    background-color: #2a2f38;\n    color: #888888;\n  }\n\n  .fire-drywall-section__tag--good {\n    background-color: rgba(212, 175, 55, 0.12);\n    color: #d4af37;\n  }\n\n  @media (max-width: 768px) {\n    .fire-drywall-section__inner {\n      grid-template-columns: 1fr;\n      gap: 40px;\n    }\n\n    .fire-drywall-section__title {\n      font-size: 26px;\n    }\n  }\n<\/style>\n\n<div class=\"fire-drywall-section\">\n  <div class=\"fire-drywall-section__inner\">\n\n    <div>\n      <p class=\"fire-drywall-section__eyebrow\">The Drywall Problem<\/p>\n      <h2 class=\"fire-drywall-section__title\">Most \"fireproof\" safes use drywall. Seriously.<\/h2>\n      <p class=\"fire-drywall-section__body\">Open up the walls of most gun safes and you'll find sheetrock — the exact same drywall used in residential construction. When drywall fails, it cracks, crumbles, and separates from the walls — exposing everything inside to direct heat.<\/p>\n      <p class=\"fire-drywall-section__body\">Worse: the steam released when drywall degrades destroys documents, photographs, and electronics — even before the fire breaches the shell.<\/p>\n    <\/div>\n\n    <div class=\"fire-drywall-section__cards\">\n\n      <div class=\"fire-drywall-section__card fire-drywall-section__card--bad\">\n        <span class=\"fire-drywall-section__card-label\">Contents at risk<\/span>\n        <div class=\"fire-drywall-section__card-tags\">\n          <span class=\"fire-drywall-section__tag\">Cracks<\/span>\n          <span class=\"fire-drywall-section__tag\">Steam<\/span>\n          <span class=\"fire-drywall-section__tag\">Crumbles<\/span>\n          <span class=\"fire-drywall-section__tag\">Heat penetration<\/span>\n        <\/div>\n      <\/div>\n\n      <div class=\"fire-drywall-section__card fire-drywall-section__card--good\">\n        <span class=\"fire-drywall-section__card-label\">Contents protected<\/span>\n        <div class=\"fire-drywall-section__card-tags\">\n          <span class=\"fire-drywall-section__tag fire-drywall-section__tag--good\">2.5\" Ceramic Wool<\/span>\n          <span class=\"fire-drywall-section__tag fire-drywall-section__tag--good\">No moisture<\/span>\n          <span class=\"fire-drywall-section__tag fire-drywall-section__tag--good\">No cracking<\/span>\n          <span class=\"fire-drywall-section__tag fire-drywall-section__tag--good\">2,300°F rated<\/span>\n        <\/div>\n      <\/div>\n\n    <\/div>\n\n  <\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_GiyGAm":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_FxjkeH":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Anton&display=swap');\n\n  .fire-wool-section {\n    background-color: #060b17;\n    padding: 80px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n    text-align: center;\n  }\n\n  .fire-wool-section__inner {\n    max-width: 900px;\n    margin: 0 auto;\n  }\n\n  .fire-wool-section__eyebrow {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: #d4af37;\n    margin: 0 0 16px 0;\n  }\n\n  .fire-wool-section_