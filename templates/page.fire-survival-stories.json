ion_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_mWTpYb":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Anton&display=swap');\n\n  .cases-section {\n    background-color: #11151a;\n    padding: 60px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .cases-section__inner {\n    max-width: 900px;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    gap: 24px;\n  }\n\n  .cases-section__card {\n    background-color: #1a1f27;\n    border: 1px solid #2a2f38;\n    border-left: 3px solid #d9b84d;\n    border-radius: 0;\n    padding: 32px;\n  }\n\n  .cases-section__card-title {\n    font-family: 'Anton', sans-serif;\n    font-size: 22px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: 0 0 24px 0;\n    letter-spacing: 0.01em;\n  }\n\n  .cases-section__card-body {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 24px;\n  }\n\n  .cases-section__col-label {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #888888;\n    margin: 0 0 8px 0;\n  }\n\n  .cases-section__col-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    color: #cccccc;\n    line-height: 1.7;\n    margin: 0 0 16px 0;\n  }\n\n  .cases-section__warranty {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    font-weight: 700;\n    color: #d9b84d;\n  }\n\n  .cases-section__warranty svg {\n    width: 16px;\n    height: 16px;\n    color: #d9b84d;\n    flex-shrink: 0;\n  }\n\n  @media (max-width: 768px) {\n    .cases-section__card-body {\n      grid-template-columns: 1fr;\n      gap: 20px;\n    }\n\n    .cases-section__card-title {\n      font-size: 18px;\n    }\n\n    .cases-section__card {\n      padding: 24px 20px;\n    }\n  }\n<\/style>\n\n<div class=\"cases-section\">\n  <div class=\"cases-section__inner\">\n\n    <div class=\"cases-section__card\">\n      <h3 class=\"cases-section__card-title\">Partial Burn-Down — Northern California<\/h3>\n      <div class=\"cases-section__card-body\">\n        <div>\n          <p class=\"cases-section__col-label\">The Fire<\/p>\n          <p class=\"cases-section__col-text\">House fire originating in the garage spread to the main structure. Fire burned for approximately 45 minutes before suppression. Safe was exposed to direct flame contact.<\/p>\n        <\/div>\n        <div>\n          <p class=\"cases-section__col-label\">The Result<\/p>\n          <p class=\"cases-section__col-text\">Interior temperature stayed below 300°F. All firearms and documents intact. Safe replaced under the Deductible Guarantee.<\/p>\n          <div class=\"cases-section__warranty\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n            <\/svg>\n            Safe replaced under warranty\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <div class=\"cases-section__card\">\n      <h3 class=\"cases-section__card-title\">Total Loss — Pacific Northwest<\/h3>\n      <div class=\"cases-section__card-body\">\n        <div>\n          <p class=\"cases-section__col-label\">The Fire<\/p>\n          <p class=\"cases-section__col-text\">Complete structural loss. Home burned to the foundation. Safe was recovered from the debris field after the structure collapsed onto it.<\/p>\n        <\/div>\n        <div>\n          <p class=\"cases-section__col-label\">The Result<\/p>\n          <p class=\"cases-section__col-text\">Exterior heavily damaged from collapse and heat. Interior ceramic wool maintained structural integrity. All contents recovered undamaged. Safe replaced.<\/p>\n          <div class=\"cases-section__warranty\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n            <\/svg>\n            Safe replaced under warranty\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n\n    <div class=\"cases-section__card\">\n      <h3 class=\"cases-section__card-title\">Delayed Suppression — Central Valley<\/h3>\n      <div class=\"cases-section__card-body\">\n        <div>\n          <p class=\"cases-section__col-label\">The Fire<\/p>\n          <p class=\"cases-section__col-text\">Rural property fire with extended response time. Fire burned unchecked for over an hour before suppression. Safe sat in a fully involved room for the majority of that time.<\/p>\n        <\/div>\n        <div>\n          <p class=\"cases-section__col-label\">The Result<\/p>\n          <p class=\"cases-section__col-text\">Interior remained below the ignition point of paper (451°F). Firearms functional. Documents legible. Owner received replacement safe within 30 days.<\/p>\n          <div class=\"cases-section__warranty\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n            <\/svg>\n            Safe replaced under warranty\n          <\/div>\n        <\/div>\n      <\/div>\n    <\/div>\n\n  <\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_bT7U8p":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    wid