n_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":32,"padding-block-end":22}},"custom_liquid_EzFkiR":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_PhjQJY":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"{% comment %} Section: Fire Insulator {% endcomment %}\n<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Anton&display=swap');\n\n  .fire-insulator-section {\n    background-color: #11151a;\n    padding: 80px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .fire-insulator-section__inner {\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  .fire-insulator-section__eyebrow {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: #d4af37;\n    margin: 0 0 16px 0;\n    text-align: center;\n  }\n\n  .fire-insulator-section__title {\n    font-family: 'Anton', sans-serif;\n    font-size: 36px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: 0 0 24px 0;\n    letter-spacing: 0.01em;\n    line-height: 1.2;\n    text-align: center;\n  }\n\n  .fire-insulator-section__intro {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 15px;\n    color: #aaaaaa;\n    line-height: 1.8;\n    max-width: 680px;\n    margin: 0 auto 64px auto;\n    text-align: center;\n  }\n\n  .fire-insulator-section__intro strong {\n    color: #d4af37;\n    font-weight: 700;\n  }\n\n  .fire-insulator-section__blocks {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n  }\n\n  .fire-insulator-section__block {\n    background-color: #1a1f27;\n    border: 1px solid #2a2f38;\n    border-left: 3px solid #d4af37;\n    padding: 32px 36px;\n  }\n\n  .fire-insulator-section__block-label {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #d4af37;\n    margin: 0 0 10px 0;\n  }\n\n  .fire-insulator-section__block-title {\n    font-family: 'Anton', sans-serif;\n    font-size: 24px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: 0 0 14px 0;\n    letter-spacing: 0.01em;\n    line-height: 1.2;\n  }\n\n  .fire-insulator-section__block-body {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: #aaaaaa;\n    line-height: 1.8;\n    margin: 0;\n  }\n\n  .fire-insulator-section__list {\n    list-style: none;\n    margin: 16px 0 0 0;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .fire-insulator-section__list-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: #cccccc;\n    line-height: 1.6;\n  }\n\n  .fire-insulator-section__list-item svg {\n    width: 14px;\n    height: 14px;\n    flex-shrink: 0;\n    margin-top: 4px;\n    color: #d4af37;\n  }\n\n  @media (max-width: 768px) {\n    .fire-insulator-section {\n      padding: 56px 20px;\n    }\n\n    .fire-insulator-section__title {\n      font-size: 26px;\n    }\n\n    .fire-insulator-section__intro {\n      font-size: 14px;\n      margin-bottom: 40px;\n    }\n\n    .fire-insulator-section__blocks {\n      grid-template-columns: 1fr;\n    }\n\n    .fire-insulator-section__block {\n      padding: 24px 22px;\n    }\n\n    .fire-insulator-section__block-title {\n      font-size: 20px;\n    }\n  }\n<\/style>\n\n<div class=\"fire-insulator-section\">\n  <div class=\"fire-insulator-section__inner\">\n\n    <p class=\"fire-insulator-section__eyebrow\"><\/p>\n    <h2 class=\"fire-insulator-section__title\">A REAL Fire Insulator<\/h2>\n    <p class=\"fire-insulator-section__intro\">Currently used in industrial ovens and kilns. Even NASA uses it on their spacecrafts. We build every fire-lined safe with the exact same insulation used in industrial ovens and kilns which are designed to handle over <strong>2,300&deg;F<\/strong> of relentless heat. These materials don't just \"slow down\" heat, they block it.<\/p>\n\n    <div class=\"fire-insulator-section__blocks\">\n\n      <div class=\"fire-insulator-section__block\">\n        <p class=\"fire-insulator-section__block-label\">Durability<\/p>\n        <h3 class=\"fire-insulator-section__block-title\">Won't Deteriorate<\/h3>\n        <p class=\"fire-insulator-section__block-body\">It can go through a fire, and another fire, and another... It holds its shape and fire resistance strength even after being exposed to extreme temperatures.<\/p>\n      <\/div>\n\n      <div class=\"fire-insulator-section__block\">\n        <p class=\"fire-insulator-section__block-label\">Construction<\/p>\n        <h3 class=\"fire-insulator-section__block-title\">Fine Details<\/h3>\n        <p class=\"fire-insulator-section__block-body\">Application changes depending on where it's going.<\/p>\n        <ul class=\"fire-insulator-section__list\">\n          <li class=\"fire-insulator-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/><\/svg>\n            Each right, left, and back wall, along with the door jambs, is packed with 2.5\" of 2300&deg;F-rated, 8 lb. density ceramic wool, compressed to 2&frac14; inches\n          <\/li>\n          <li class=\"fire-insulator-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/><\/svg>\n            The top and bottom walls will have 2.5\" of ceramic insulator and 2\" of glass blanket, compressed to 4\"\n          <\/li>\n          <li class=\"fire-insulator-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/><\/svg>\n            The door will have 2.5\" of ceramic insulator and 1\" glass blanket, compressed to 3\"\n          <\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"fire-insulator-section__block\">\n        <p class=\"fire-insulator-section__block-label\">Coverage<\/p>\n        <h3 class=\"fire-insulator-section__block-title\">We Don't Skimp Out<\/h3>\n        <p class=\"fire-insulator-section__block-body\">That's a lot of insulation. Sturdy gives you more of this premium ceramic and glass insulation than most manufacturers. Thicker layers, denser coverage, and complete protection from top to bottom. While others cut corners to save costs, we pack in every inch of heat-blocking material your safe can hold without weak spots. Every inch of your safe &mdash; walls, door, top, and bottom &mdash; is packed with perfectly compressed insulation that won't shift, sag, or leave gaps over time.<\/p>\n      <\/div>\n\n      <div class=\"fire-insulator-section__block\">\n        <p class=\"fire-insulator-section__block-label\">Interior<\/p>\n        <h3 class=\"fire-insulator-section__block-title\">16g Inside Steel Liner<\/h3>\n        <p class=\"fire-insulator-section__block-body\">Does more than hold ceramic in. A rugged 16-gauge steel interior liner helps compress and cover the insulation material. It also adds more strength, so your shelves won't buckle under pressure like others anchoring shelving into drywall and thin felt. You can also do things such as add magnet storage systems inside and decorative vinyl stickers.<\/p>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_nQAxY4":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"section_xPg7cf":{"type":"section","blocks":{"text_rfWNPk":{"type":"text","name":"t:names.text","settings":{"text":"<h2>Watch the Magic Happen: See How It's Applied.<\/h2>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"video_BqPNwg":{"type":"video","