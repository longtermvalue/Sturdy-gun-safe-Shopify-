order_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":32,"padding-block-end":32}},"section_R6dQNi":{"type":"section","blocks":{"image_Fpbp3P":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/gun_safe_fire_gasket.webp","link":"","image_ratio":"landscape","width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"group_WfLziD":{"type":"group","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":12,"width":"custom","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","custom_height":100,"inherit_color_scheme":true,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","link":"","open_in_new_tab":false,"placeholder":"","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"text_bBrMyg":{"type":"text","name":"t:names.heading","settings":{"text":"<h3>Tight Seal Right From The Start<\/h3>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_ThzD7x":{"type":"text","settings":{"text":"<p>The weakest point on most fire safes is the door seal. If heat and smoke slip through that tiny gap, everything inside is at risk. That’s why we use the same sealing technology trusted in industrial ovens and kilns. Places built to handle <strong>extreme, nonstop heat<\/strong>. Every <strong>Sturdy Gun Safe<\/strong> with fire lining features a <strong>UL-tested fire caulking and a precision-fit boiler gasket<\/strong>, not the cheap, one-size-fits-all gaskets most safes use.<\/p><p>Here’s what makes ours different:<\/p><ul><li><strong>Real fire defense:<\/strong> Our <strong>LCI Firestop Sealant<\/strong> can block fire, smoke, and moisture for up to <strong>3 hours<\/strong>, and when temperatures rise, it <strong>expands up to eight times its size<\/strong> to form a complete seal.<br\/><\/li><li><strong>More coverage = more protection:<\/strong> Our <strong>boiler gasket is twice as wide<\/strong> as the average competitor’s, giving you <strong>2× the sealing power<\/strong> where it matters most, around the door.<br\/><\/li><li><strong>Custom-fit seal:<\/strong> No two safes have exactly the same door clearance, so we custom-fit every gasket for a perfect seal right from the start. Competitors often use <strong>Palusol gaskets<\/strong>, which only expand <em>after<\/em> they get hot.<\/li><\/ul><p>Watch a <a href=\"https:\/\/youtu.be\/bJcf_mUZnb0?si=m-n54ctk-fdbd1um\" title=\"https:\/\/youtu.be\/bJcf_mUZnb0?si=m-n54ctk-fdbd1um\">video<\/a> on how they are applied.<\/p>","width":"fit-content","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_bBrMyg","text_ThzD7x"]}},"block_order":["image_Fpbp3P","group_WfLziD"],"name":"t:names.image_with_text","settings":{"content_direction":"row","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":32,"section_width":"page-width","section_height":"","section_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":81,"padding-block-end":81}},"slideshow_bDGhCi":{"type":"slideshow","blocks":{"slide_UVKEJY":{"type":"_slide","settings":{"media_type_1":"image","image_1":"shopify:\/\/shop_images\/manconfusedaboutfireratingforgunsafe.webp","content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":12,"inherit_color_scheme":false,"color_scheme":"scheme-6","toggle_overlay":true,"overlay_color":"#000000a6","overlay_style":"solid","gradient_direction":"to top","padding-block-start":48,"padding-block-end":48,"padding-inline-start":48,"padding-inline-end":48},"blocks":{"text_giRbmW":{"type":"text","name":"t:names.heading","settings":{"text":"<p>What's Our Fire Rating?<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_wrTzag":{"type":"text","settings":{"text":"<p>We don't advertise a \"fire rating\" like a lot of other safe companies do and that's on purpose. We refuse to mislead our customers with numbers that don't actually mean anything in the real world. Our competitors either use made-up fire ratings or incomplete tests that skip key steps, such as including the excessively long cool down time where items are still cooking! Right now, there are no long-gun RSC safes on the market with a true UL fire rating. A UL security rating, which tells you how hard it is to break into a safe, does not mean the safe is fireproof either.<\/p>","width":"fit-content","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":20,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"button_PLqMG8":{"type":"button","settings":{"label":"Truth About Ratings","link":"shopify:\/\/collections\/all","open_in_new_tab":false,"style_class":"button-secondary","width":"fit-content","custom_width":100,"width_mobile":"fit-content","custom_width_mobile":100},"blocks":{}}},"block_order":["text_giRbmW","text_wrTzag","button_PLqMG8"]},"slide_g3gFwh":{"type":"_slide","settings":{"media_type_1":"image","image_1":"shopify:\/\/shop_images\/guns_safe_testingbyfireandover.webp","content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":12,"inherit_color_scheme":false,"color_scheme":"scheme-6","toggle_overlay":true,"overlay_color":"#00000096","overlay_style":"solid","gradient_direction":"to top","padding-block-start":48,"padding-block-end":48,"padding-inline-start":48,"padding-inline-end":48},"blocks":{"text_hMG8EF":{"type":"text","name":"t:names.heading","settings":{"text":"<h3>How We Tested Vs. Our Competitors<\/h3>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_MJxaCP":{"type":"text","settings":{"text":"<p>Some safe companies test their fire proof safes in controlled testing furnaces which perform like oversized house ovens yet get a lot hotter than your normal oven. These safe companies eliminate 2 important factors when testing their gun safes to get those ratings: Point Of No Return, and Cool Down Time. Read more about how Sturdy Safe vs. other gun safe companies test for fire ratings.<\/p>","width":"fit-content","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":20,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"button_b3gEjL":{"type":"button","settings":{"label":"Real Burns","link":"shopify:\/\/collections\/all","open_in_new_tab":false,"style_class":"button-secondary","width":"fit-content","custom_width":100,"width_mobile":"fit-content","custom_width_mobile":100},"blocks":{}}},"block_order":["text_hMG8EF","text_MJxaCP","button_b3gEjL"]},"slide_e38zd8":{"type":"_slide","settings":{"media_type_1":"image","image_1":"shopify:\/\/shop_images\/sturdygunsafeinhousefirenotfirelined.webp","content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":12,"inherit_color_scheme":false,"color_scheme":"scheme-6","toggle_overlay":true,"overlay_color":"#000000bd","overlay_style":"solid","gradient_direction":"to top","padding-block-start":48,"padding-block-end":48,"padding-inline-start":48,"padding-inline-end":48},"blocks":{"text_XKg8CY":{"type":"text","name":"t:names.heading","settings":{"text":"<h3>Fire Resistance: Optional, Not Mandatory<\/h3>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_AFb9Yj":{"type":"text","settings":{"text":"<p>Fire-resistant safes aren’t for everyone—and with Sturdy Safe, you only pay for what you need. If you’re on a budget, it’s smarter to choose our uninsulated safe with thick steel than a thin, sheetrock-lined safe that offers little real protection. If your insurance covers contents, you’re near a fire department, keep the safe in a low-burn area (like brick or concrete), or have sprinklers, insulation may not be necessary. One of our uninsulated safes even withstood a partial house fire (13-minute response time), proving thick steel and size alone provide some fire resistance—though not as much as our insulated models.<\/p>","width":"fit-content","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","le