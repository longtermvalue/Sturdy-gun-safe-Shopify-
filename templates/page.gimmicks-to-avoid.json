060b17c2","overlay_style":"solid","gradient_direction":"to top","blurred_reflection":false,"reflection_opacity":75,"padding-block-start":40,"padding-block-end":40}},"custom_liquid_t494yG":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"section_jQE46X":{"type":"section","blocks":{"text_CtidqK":{"type":"text","settings":{"text":"<p>The gun safe industry spends more on marketing features that look impressive than on engineering features that actually protect.<\/p>","width":"100%","max_width":"normal","alignment":"center","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_HBJiVD":{"type":"text","name":"t:names.text","settings":{"text":"<p>Here are the most common gimmicks — and what to look for instead.<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_CtidqK","text_HBJiVD"],"name":"t:names.pull_quote","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":16,"section_width":"page-width","section_height":"","section_height_custom":50,"color_scheme":"scheme-5","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":89,"padding-block-end":0}},"custom_liquid_Tb8R4y":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Anton&display=swap');\n\n  .tactics-section {\n    background-color: #11151a;\n    padding: 80px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .tactics-section__inner {\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n\n  .tactics-section__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n  }\n\n  .tactics-section__card {\n    background-color: #1a1f27;\n    border: 1px solid #2a2f38;\n    padding: 32px 28px;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .tactics-section__card-number {\n    font-family: 'Anton', sans-serif;\n    font-size: 13px;\n    font-weight: 400;\n    color: #d4af37;\n    letter-spacing: 0.1em;\n  }\n\n  .tactics-section__card-title {\n    font-family: 'Anton', sans-serif;\n    font-size: 22px;\n    font-weight: 400;\n    color: #ffffff;\n    letter-spacing: 0.01em;\n    line-height: 1.2;\n    margin: 0;\n  }\n\n  .tactics-section__divider {\n    width: 32px;\n    height: 1px;\n    background-color: #d4af37;\n  }\n\n  .tactics-section__block {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n\n  .tactics-section__block-label {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #d4af37;\n  }\n\n  .tactics-section__block-label--reality {\n    color: #888888;\n  }\n\n  .tactics-section__block-label--ask {\n    color: #d4af37;\n  }\n\n  .tactics-section__block-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    color: #aaaaaa;\n    line-height: 1.7;\n  }\n\n  .tactics-section__block-text--claim {\n    color: #666666;\n    font-style: italic;\n  }\n\n  .tactics-section__block-text--ask {\n    color: #cccccc;\n    font-weight: 600;\n  }\n\n  @media (max-width: 768px) {\n    .tactics-section__grid {\n      grid-template-columns: 1fr;\n    }\n\n    .tactics-section__card-title {\n      font-size: 20px;\n    }\n  }\n<\/style>\n\n<div class=\"tactics-section\">\n  <div class=\"tactics-section__inner\">\n    <div class=\"tactics-section__grid\">\n\n      <div class=\"tactics-section__card\">\n        <span class=\"tactics-section__card-number\">01<\/span>\n        <h3 class=\"tactics-section__card-title\">Inflated Bolt Counts<\/h3>\n        <div class=\"tactics-section__divider\"><\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label\">The Claim<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--claim\">\"24 locking bolts for maximum security!\"<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--reality\">The Reality<\/span>\n          <p class=\"tactics-section__block-text\">Bolt count means nothing without steel thickness to back it up. A safe with 24 bolts in 14-gauge steel fails faster than a safe with 8 bolts in .22-inch steel. The bolts are only as strong as the steel they're bolted to. More bolts in thin steel is like adding more locks to a cardboard door.<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--ask\">Ask Instead<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--ask\">\"How thick is the steel body and door plate?\"<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"tactics-section__card\">\n        <span class=\"tactics-section__card-number\">02<\/span>\n        <h3 class=\"tactics-section__card-title\">Center-Mounted Handles<\/h3>\n        <div class=\"tactics-section__divider\"><\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label\">The Claim<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--claim\">Looks balanced and symmetrical.<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--reality\">The Reality<\/span>\n          <p class=\"tactics-section__block-text\">Center-mounted handles create wobble and uneven wear on the linkage mechanism. Every time you turn the handle, force is applied unevenly across the locking bolts. Over time, this leads to linkage failure — which locks you out of your own safe.<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--ask\">Ask Instead<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--ask\">\"Is the handle side-mounted with shaft support?\" (Sturdy uses side-mounted handles with direct shaft support for even force distribution.)<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"tactics-section__card\">\n        <span class=\"tactics-section__card-number\">03<\/span>\n        <h3 class=\"tactics-section__card-title\">Misleading Fire Ratings<\/h3>\n        <div class=\"tactics-section__divider\"><\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label\">The Claim<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--claim\">\"90 minutes at 1,400°F!\"<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--reality\">The Reality<\/span>\n          <p class=\"tactics-section__block-text\">There's no industry standard for gun safe fire ratings. Any manufacturer can claim any number. What matters is the insulation material: drywall crumbles and steams. Ceramic wool doesn't.<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--ask\">Ask Instead<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--ask\">\"What insulation material do you use, and at what temperature is it rated?\"<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"tactics-section__card\">\n        <span class=\"tactics-section__card-number\">04<\/span>\n        <h3 class=\"tactics-section__card-title\">\"Military Grade\" \/ \"Bank Vault\" Marketing<\/h3>\n        <div class=\"tactics-section__divider\"><\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label\">The Claim<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--claim\">Sounds like it's built for combat or Fort Knox.<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--reality\">The Reality<\/span>\n          <p class=\"tactics-section__block-text\">\"Military grade\" has no standard definition in the safe industry. Actual bank vaults use concrete-reinforced walls several feet thick. A residential gun safe is not a bank vault regardless of what the sticker says.<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--ask\">Ask Instead<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--ask\">\"What are the published steel gauges for the body and door?\"<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"tactics-section__card\">\n        <span class=\"tactics-section__card-number\">05<\/span>\n        <h3 class=\"tactics-section__card-title\">Drywall Fire Insulation Sold as \"Fireboard\"<\/h3>\n        <div class=\"tactics-section__divider\"><\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label\">The Claim<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--claim\">\"Advanced fireboard technology.\"<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--reality\">The Reality<\/span>\n          <p class=\"tactics-section__block-text\">It's drywall. Gypsum board. Sheetrock. Different names for the same commodity material that breaks down at 176°F and releases steam into the safe during a fire. The steam destroys documents, photographs, and electronics — even if the safe's shell survives.<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--ask\">Ask Instead<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--ask\">\"Is the insulation ceramic wool or gypsum-based?\"<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"tactics-section__card\">\n        <span class=\"tactics-section__card-number\">06<\/span>\n        <h3 class=\"tactics-section__card-title\">Hidden Hinges<\/h3>\n        <div class=\"tactics-section__divider\"><\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label\">The Claim<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--claim\">\"Hidden hinges prevent tampering!\"<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--reality\">The Reality<\/span>\n          <p class=\"tactics-section__block-text\">Hinges don't hold the door closed — deadbolts do. Hidden hinges are a cosmetic choice, not a security feature. Worse, they prevent the door from opening 180°, risk damage if opened too far, and make the door harder to remove for moving.<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--ask\">Ask Instead<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--ask\">\"How many deadbolts, and can the door be removed for easier moving?\"<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"tactics-section__card\">\n        <span class=\"tactics-section__card-number\">07<\/span>\n        <h3 class=\"tactics-section__card-title\">Thin Steel with Thick Paint<\/h3>\n        <div class=\"tactics-section__divider\"><\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label\">The Claim<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--claim\">The safe feels solid and looks substantial.<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--reality\">The Reality<\/span>\n          <p class=\"tactics-section__block-text\">A thick powder coat or textured finish can make thin steel feel thicker than it is. The best way to evaluate is by published gauge: ask for the number, not the feel.<\/p>\n        <\/div>\n        <div class=\"tactics-section__block\">\n          <span class=\"tactics-section__block-label tactics-section__block-label--ask\">Ask Instead<\/span>\n          <p class=\"tactics-section__block-text tactics-section__block-text--ask\">\"What is the published gauge of the body and door in inches?\"<\/p>\n        <\/div>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"main":{"type":"main-page","blocks":{"heading":{"type":"text","name":"Title","settings":{"text":"<h1>{{ closest.page.title }}<\/h1>","width":"100%","max_width":"normal","alignment":"left","type_preset":"h2","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"page-content":{"type":"page-content","settings":{},"blocks":{}}},"block_order":["heading","page-content"],"disabled":true,"settings":{"content_direction":"column","gap":32,"color_scheme":"","padding-block-start":60,"padding-block-end":60}},"custom_liquid_MXTdqy":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"p