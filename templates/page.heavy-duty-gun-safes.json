dding-block-end":40}},"custom_liquid_eTddC3":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"section_cewkHk":{"type":"section","blocks":{"text_CLxkjm":{"type":"text","settings":{"text":"<p>The Heavy Duty line is what built Sturdy's reputation.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_MXXfd3":{"type":"text","settings":{"text":"<p>Every safe starts with a .22-inch (4 gauge) American steel body — nearly a quarter inch of solid protection. The door begins at 3\/8-inch plate steel backed by a 3\/16-inch reinforcing frame, creating three inches of total door depth.<\/p><p>These are safes that resist pry bars, power tools, and brute force at a level most safes at double the price cannot match. We have tested them on camera with forklifts, sledgehammers, axes, and pry bars — and they are still protecting families across America.<\/p><p>Every Heavy Duty safe includes our simplified linkage with no shear pins or clutch failures, a fully recessed door with airtight tolerances, continuous hot-welded seams, and 12-bend uni-body construction. Add fire protection with 2.5 inches of 2,300°F ceramic wool and you have a safe that handles both burglary and fire with equal confidence.<\/p><p>Nine standard sizes or request a custom build. Built to order in Fresno, California. Backed by our lifetime warranty and deductible guarantee.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"paragraph","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_CLxkjm","text_MXXfd3"],"name":"t:names.pull_quote","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":16,"section_width":"page-width","section_height":"","section_height_custom":50,"color_scheme":"scheme-3","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":40,"padding-block-end":40}},"custom_liquid_DzbFUQ":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"