quid":"<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Anton&display=swap');\n\n  .faq-hd-section {\n    background-color: #11151a;\n    padding: 60px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .faq-hd-section__inner {\n    max-width: 900px;\n    margin: 0 auto;\n  }\n\n  .faq-hd-section__title {\n    font-family: 'Anton', sans-serif;\n    font-size: 36px;\n    font-weight: 400;\n    color: #d4af37;\n    margin: 0 0 40px 0;\n    letter-spacing: 0.01em;\n  }\n\n  .faq-hd-section__list {\n    display: flex;\n    flex-direction: column;\n    border-top: 1px solid #2a2f38;\n  }\n\n  .faq-hd-section__item {\n    border-bottom: 1px solid #2a2f38;\n  }\n\n  .faq-hd-section__question {\n    width: 100%;\n    background: none;\n    border: none;\n    padding: 24px 0;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    cursor: pointer;\n    text-align: left;\n  }\n\n  .faq-hd-section__question-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 15px;\n    font-weight: 700;\n    color: #ffffff;\n    line-height: 1.4;\n  }\n\n  .faq-hd-section__icon {\n    flex-shrink: 0;\n    width: 20px;\n    height: 20px;\n    color: #d4af37;\n    transition: transform 0.3s ease;\n  }\n\n  .faq-hd-section__item.is-open .faq-hd-section__icon {\n    transform: rotate(45deg);\n  }\n\n  .faq-hd-section__answer {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.4s ease;\n  }\n\n  .faq-hd-section__item.is-open .faq-hd-section__answer {\n    max-height: 600px;\n  }\n\n  .faq-hd-section__answer-inner {\n    padding: 0 0 24px 0;\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: #aaaaaa;\n    line-height: 1.8;\n    max-width: 780px;\n  }\n\n  @media (max-width: 768px) {\n    .faq-hd-section__title {\n      font-size: 26px;\n    }\n\n    .faq-hd-section__question-text {\n      font-size: 14px;\n    }\n\n    .faq-hd-section__answer-inner {\n      font-size: 13px;\n    }\n\n    .faq-hd-section__question {\n      padding: 20px 0;\n    }\n  }\n<\/style>\n\n<div class=\"faq-hd-section\">\n  <div class=\"faq-hd-section__inner\">\n\n    <h2 class=\"faq-hd-section__title\">Frequently Asked Questions<\/h2>\n\n    <div class=\"faq-hd-section__list\">\n\n      <div class=\"faq-hd-section__item\">\n        <button class=\"faq-hd-section__question\">\n          <span class=\"faq-hd-section__question-text\">What's the thickest steel in the Heavy Duty line?<\/span>\n          <svg class=\"faq-hd-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-hd-section__answer\">\n          <p class=\"faq-hd-section__answer-inner\">The body starts at .22 inches (4 gauge) American A36–Grade 50 steel. The door starts at 3\/8 inch plate backed by a 3\/16-inch reinforcing frame for approximately 3 inches of total door depth.<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"faq-hd-section__item\">\n        <button class=\"faq-hd-section__question\">\n          <span class=\"faq-hd-section__question-text\">Can I add fire protection?<\/span>\n          <svg class=\"faq-hd-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-hd-section__answer\">\n          <p class=\"faq-hd-section__answer-inner\">Yes. The fire lining option adds 2.5 inches of 2,300°F ceramic wool to the body and door. This is the same material used in industrial kilns — not the drywall that most competitors use.<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"faq-hd-section__item\">\n        <button class=\"faq-hd-section__question\">\n          <span class=\"faq-hd-section__question-text\">What lock options are available?<\/span>\n          <svg class=\"faq-hd-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-hd-section__answer\">\n          <p class=\"faq-hd-section__answer-inner\">All Heavy Duty safes use Sargent & Greenleaf locks. You choose mechanical combination dial (Group 2, model 6730) or Titan D-Drive electronic with illuminated keypad. Both are covered under our lifetime warranty.<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"faq-hd-section__item\">\n        <button class=\"faq-hd-section__question\">\n          <span class=\"faq-hd-section__question-text\">Are the safes delivered assembled?<\/span>\n          <svg class=\"faq-hd-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-hd-section__answer\">\n          <p class=\"faq-hd-section__answer-inner\">Yes. Each safe ships fully assembled. Delivery is curbside by default. White-glove placement with a moving team is available for an additional fee.<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"faq-hd-section__item\">\n        <button class=\"faq-hd-section__question\">\n          <span class=\"faq-hd-section__question-text\">Can I get a custom size?<\/span>\n          <svg class=\"faq-hd-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-hd-section__answer\">\n          <p class=\"faq-hd-section__answer-inner\">Yes. Custom dimensions are available for the Heavy Duty line. Contact our sales team with your exact opening measurements. Lead time on custom builds is 6–8 weeks.<\/p>\n        <\/div>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\n  document.querySelectorAll('.faq-hd-section__question').forEach(button => {\n    button.addEventListener('click', () => {\n      const item = button.closest('.faq-hd-section__item');\n      const isOpen = item.classList.contains('is-open');\n\n      document.querySelectorAll('.faq-hd-section__item.is-open').forEach(open => {\n        open.classList.remove('is-open');\n      });\n\n      if (!isOpen) {\n        item.classList.add('is-open');\n      }\n    });\n  });\n<\/script>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_fgjBeL":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}}},"order":["hero_qNxayP","custom_liquid_eTddC3","section_cewkHk","custom_liquid_DzbFUQ","custom_liquid_fabWgz","custom_liquid_EmUNGU","product_list_6xf7J8","main","custom_liquid_RM7Nwa","custom_liquid_xdTKqG","custom_liquid_fgjBeL"]}