tColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n        <\/svg>\n        Use caution when closing or opening the door\n      <\/div>\n      <div class=\"warranty-buyer__list-item\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n        <\/svg>\n        Never force or strike the dial\n      <\/div>\n      <div class=\"warranty-buyer__list-item\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n        <\/svg>\n        Lock the dial while moving the safe or vault\n      <\/div>\n      <div class=\"warranty-buyer__list-item\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n        <\/svg>\n        Bolt it down to prevent theft of the entire safe\n      <\/div>\n      <div class=\"warranty-buyer__list-item\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n        <\/svg>\n        Keep children at a safe distance at all times\n      <\/div>\n    <\/div>\n\n  <\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_V6DJNd":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Ant