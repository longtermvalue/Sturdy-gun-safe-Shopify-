font-family: 'Anton', sans-serif;\n    font-size: 42px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: 0 0 48px 0;\n    letter-spacing: 0.01em;\n  }\n\n  .linkage-section__cards {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n    text-align: left;\n  }\n\n  .linkage-section__card {\n    background-color: #1a1f27;\n    border: 1px solid #2a2f38;\n    padding: 28px;\n    display: flex;\n    flex-direction: column;\n    gap: 28px;\n  }\n\n  .linkage-section__card--sturdy {\n    border-color: #d4af37;\n  }\n\n  .linkage-section__card-header {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .linkage-section__card-header svg {\n    width: 16px;\n    height: 16px;\n    flex-shrink: 0;\n  }\n\n  .linkage-section__card-header-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: #555555;\n  }\n\n  .linkage-section__card--sturdy .linkage-section__card-header-text {\n    color: #d4af37;\n  }\n\n  \/* Diagrams *\/\n  .linkage-section__diagram {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 16px 0;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n\n  \/* Competitor diagram *\/\n  .linkage-section__block {\n    width: 40px;\n    height: 32px;\n    background-color: #2a2f38;\n    border: 1px solid #3a3f48;\n    border-radius: 2px;\n    flex-shrink: 0;\n  }\n\n  .linkage-section__block--small {\n    width: 28px;\n    height: 22px;\n  }\n\n  .linkage-section__line-h {\n    height: 2px;\n    width: 24px;\n    background-color: #3a3f48;\n    flex-shrink: 0;\n  }\n\n  .linkage-section__x-node {\n    width: 28px;\n    height: 28px;\n    border-radius: 50%;\n    border: 2px solid #555555;\n    background-color: #1a1f27;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n\n  .linkage-section__x-node svg {\n    width: 14px;\n    height: 14px;\n    color: #666666;\n  }\n\n  .linkage-section__fork {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    align-items: flex-start;\n  }\n\n  .linkage-section__fork-branch {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  \/* Sturdy diagram *\/\n  .linkage-section__sturdy-diagram {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    padding: 16px 0;\n  }\n\n  .linkage-section__handle {\n    width: 32px;\n    height: 32px;\n    border-radius: 50%;\n    border: 2px solid #d4af37;\n    background-color: rgba(212,175,55,0.1);\n    flex-shrink: 0;\n  }\n\n  .linkage-section__shaft {\n    height: 3px;\n    width: 60px;\n    background-color: #d4af37;\n    flex-shrink: 0;\n  }\n\n  .linkage-section__bolt-block {\n    width: 36px;\n    height: 44px;\n    background-color: rgba(212,175,55,0.2);\n    border: 2px solid #d4af37;\n    border-radius: 2px;\n    flex-shrink: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    padding: 6px 4px;\n  }\n\n  .linkage-section__bolt-bar {\n    height: 3px;\n    background-color: #d4af37;\n    border-radius: 1px;\n  }\n\n  .linkage-section__bolt-end {\n    width: 14px;\n    height: 28px;\n    background-color: rgba(212,175,55,0.3);\n    border: 2px solid #d4af37;\n    border-radius: 2px;\n    flex-shrink: 0;\n  }\n\n  \/* Diagram labels *\/\n  .linkage-section__diagram-labels {\n    display: flex;\n    justify-content: space-around;\n    margin-top: -8px;\n  }\n\n  .linkage-section__diagram-label {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 10px;\n    color: #555555;\n    text-align: center;\n  }\n\n  .linkage-section__diagram-label--sturdy {\n    color: #888888;\n  }\n\n  \/* Lists *\/\n  .linkage-section__list {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .linkage-section__list-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    color: #666666;\n    line-height: 1.5;\n  }\n\n  .linkage-section__list-item svg {\n    width: 14px;\n    height: 14px;\n    flex-shrink: 0;\n    margin-top: 2px;\n    color: #555555;\n  }\n\n  .linkage-section__card--sturdy .linkage-section__list-item {\n    color: #cccccc;\n  }\n\n  .linkage-section__card--sturdy .linkage-section__list-item svg {\n    color: #d4af37;\n  }\n\n  @media (max-width: 768px) {\n    .linkage-section__title {\n      font-size: 28px;\n    }\n\n    .linkage-section__cards {\n      grid-template-columns: 1fr;\n    }\n  }\n<\/style>\n\n<div class=\"linkage-section\">\n  <div class=\"linkage-section__inner\">\n\n    <p class=\"linkage-section__eyebrow\">The Difference<\/p>\n    <h2 class=\"linkage-section__title\">Simple is better<\/h2>\n\n    <div class=\"linkage-section__cards\">\n\n      <!-- Competitor card -->\n      <div class=\"linkage-section__card\">\n        <div class=\"linkage-section__card-header\">\n          <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\" style=\"color:#555555;\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n          <\/svg>\n          <span class=\"linkage-section__card-header-text\">Complex Linkage — Competitors<\/span>\n        <\/div>\n\n        <div>\n          <div class=\"linkage-section__diagram\" style=\"justify-content:flex-start; gap:6px;\">\n            <div class=\"linkage-section__block\"><\/div>\n            <div class=\"linkage-section__line-h\"><\/div>\n            <div class=\"linkage-section__x-node\">\n              <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n              <\/svg>\n            <\/div>\n            <div class=\"linkage-section__fork\">\n              <div class=\"linkage-section__fork-branch\">\n                <div class=\"linkage-section__line-h\" style=\"width:16px;\"><\/div>\n                <div class=\"linkage-section__x-node\">\n                  <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n                  <\/svg>\n                <\/div>\n                <div class=\"linkage-section__line-h\" style=\"width:12px;\"><\/div>\n                <div class=\"linkage-section__block--small linkage-section__block\"><\/div>\n              <\/div>\n              <div class=\"linkage-section__fork-branch\">\n                <div class=\"linkage-section__line-h\" style=\"width:16px;\"><\/div>\n                <div class=\"linkage-section__x-node\">\n                  <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n                  <\/svg>\n                <\/div>\n                <div class=\"linkage-section__line-h\" style=\"width:12px;\"><\/div>\n                <div class=\"linkage-section__block--small linkage-section__block\"><\/div>\n              <\/div>\n            <\/div>\n          <\/div>\n          <div class=\"linkage-section__diagram-labels\">\n            <span class=\"linkage-section__diagram-label\">Handle<\/span>\n            <span class=\"linkage-section__diagram-label\">Shear pin<\/span>\n            <span class=\"linkage-section__diagram-label\">Cams<\/span>\n            <span class=\"linkage-section__diagram-label\">Bolts<\/span>\n          <\/div>\n        <\/div>\n\n        <div class=\"linkage-section__list\">\n          <div class=\"linkage-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n            <\/svg>\n            Shear pins that break under force or fatigue\n          <\/div>\n          <div class=\"linkage-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n            <\/svg>\n            Clutch mechanism that wears out\n          <\/div>\n          <div class=\"linkage-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n            <\/svg>\n            Can lock you out on a door slam\n          <\/div>\n          <div class=\"linkage-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n            <\/svg>\n            Locksmith required on failure\n          <\/div>\n        <\/div>\n      <\/div>\n\n      <!-- Sturdy card -->\n      <div class=\"linkage-section__card linkage-section__card--sturdy\">\n        <div class=\"linkage-section__card-header\">\n          <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\" style=\"color:#d4af37;\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n          <\/svg>\n          <span class=\"linkage-section__card-header-text\">Simplified Linkage — Sturdy<\/span>\n        <\/div>\n\n        <div>\n          <div class=\"linkage-section__sturdy-diagram\">\n            <div class=\"linkage-section__handle\"><\/div>\n            <div class=\"linkage-section__shaft\"><\/div>\n            <div class=\"linkage-section__bolt-block\">\n              <div class=\"linkage-section__bolt-bar\"><\/div>\n              <div class=\"linkage-section__bolt-bar\"><\/div>\n              <div class=\"linkage-section__bolt-bar\"><\/div>\n            <\/div>\n            <div style=\"display:flex; flex-direction:column; gap:8px;\">\n              <div class=\"linkage-section__bolt-end\"><\/div>\n              <div class=\"linkage-section__bolt-end\"><\/div>\n            <\/div>\n          <\/div>\n          <div class=\"linkage-section__diagram-labels\">\n            <span class=\"linkage-section__diagram-label linkage-section__diagram-label--sturdy\">Handle shaft<\/span>\n            <span class=\"linkage-section__diagram-label linkage-section__diagram-label--sturdy\">Direct link<\/span>\n            <span class=\"linkage-section__diagram-label linkage-section__diagram-label--sturdy\">Bolts<\/span>\n          <\/div>\n        <\/div>\n\n        <div class=\"linkage-section__list\">\n          <div class=\"linkage-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n            <\/svg>\n            No shear pins to break\n          <\/div>\n          <div class=\"linkage-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n            <\/svg>\n            No clutch mechanism to wear\n          <\/div>\n          <div class=\"linkage-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n            <\/svg>\n            Direct mechanical connection\n          <\/div>\n          <div class=\"linkage-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n            <\/svg>\n            Side-mounted handle for even force\n          <\/div>\n          <div class=\"linkage-section__list-item\">\n            <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m4.5 12.75 6 6 9-13.5\"\/>\n            <\/svg>\n            Zero failure potential by design\n          <\/div>\n        <\/div>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"section_FhRBpf":{"type":"section","blocks":{"text_GBtbPx":{"type":"text","name":"t:names.text","settings":{"text":"<p>DURABILITY<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"paragraph","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-primary)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_ya6gWN":{"type":"text","name":"t:names.heading","settings":{"te