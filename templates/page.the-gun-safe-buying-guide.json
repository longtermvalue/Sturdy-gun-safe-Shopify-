,"group_zmyEgG"],"name":"t:names.multicolumn","settings":{"content_direction":"row","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"flex-start","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":16,"section_width":"page-width","section_height":"","section_height_custom":50,"color_scheme":"scheme-5","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":48,"padding-block-end":48}},"custom_liquid_tgWJW6":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_aA7gRK":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Anton&display=swap');\n\n  .redflags-section {\n    background-color: #11151a;\n    padding: 60px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .redflags-section__inner {\n    max-width: 1100px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .redflags-section__title {\n    font-family: 'Anton', sans-serif;\n    font-size: 32px;\n    font-weight: 400;\n    color: #ffffff;\n    margin: 0 0 16px 0;\n    letter-spacing: 0.01em;\n  }\n\n  .redflags-section__subtitle {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 15px;\n    color: #aaaaaa;\n    line-height: 1.6;\n    margin: 0 auto 40px auto;\n    max-width: 640px;\n  }\n\n  .redflags-section__grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 16px;\n    text-align: left;\n  }\n\n  .redflags-section__item {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    background-color: #1a1f27;\n    border: 1px solid #2a2f38;\n    border-radius: 0;\n    padding: 18px 20px;\n  }\n\n  .redflags-section__icon {\n    flex-shrink: 0;\n    width: 18px;\n    height: 18px;\n    color: #d9b84d;\n    margin-top: 2px;\n  }\n\n  .redflags-section__item-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    color: #cccccc;\n    line-height: 1.6;\n  }\n\n  @media (max-width: 768px) {\n    .redflags-section__title {\n      font-size: 26px;\n    }\n\n    .redflags-section__subtitle {\n      font-size: 14px;\n    }\n\n    .redflags-section__grid {\n      grid-template-columns: 1fr;\n    }\n\n    .redflags-section__item-text {\n      font-size: 13px;\n    }\n  }\n<\/style>\n\n<div class=\"redflags-section\">\n  <div class=\"redflags-section__inner\">\n\n    <h2 class=\"redflags-section__title\">Red Flags to Watch For<\/h2>\n    <p class=\"redflags-section__subtitle\">If a manufacturer or retailer does any of the following, ask for clarification before buying.<\/p>\n\n    <div class=\"redflags-section__grid\">\n\n      <div class=\"redflags-section__item\">\n        <svg class=\"redflags-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n        <\/svg>\n        <span class=\"redflags-section__item-text\">Safe is listed as \"fire-rated\" without specifying the insulation material<\/span>\n      <\/div>\n\n      <div class=\"redflags-section__item\">\n        <svg class=\"redflags-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n        <\/svg>\n        <span class=\"redflags-section__item-text\">Gauge listed as a range (\"11-14 gauge\") rather than a specific thickness<\/span>\n      <\/div>\n\n      <div class=\"redflags-section__item\">\n        <svg class=\"redflags-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n        <\/svg>\n        <span class=\"redflags-section__item-text\">Lock mechanism described as \"commercial grade\" without specifics<\/span>\n      <\/div>\n\n      <div class=\"redflags-section__item\">\n        <svg class=\"redflags-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n        <\/svg>\n        <span class=\"redflags-section__item-text\">Warranty requires returning the safe to the manufacturer at your expense<\/span>\n      <\/div>\n\n      <div class=\"redflags-section__item\">\n        <svg class=\"redflags-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n        <\/svg>\n        <span class=\"redflags-section__item-text\">Steel origin is not disclosed or described as \"domestic-grade\" without clarification<\/span>\n      <\/div>\n\n      <div class=\"redflags-section__item\">\n        <svg class=\"redflags-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n        <\/svg>\n        <span class=\"redflags-section__item-text\">\"Pry-resistant\" claims without published test methodology<\/span>\n      <\/div>\n\n      <div class=\"redflags-section__item\">\n        <svg class=\"redflags-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\"\/>\n        <\/svg>\n        <span class=\"redflags-section__item-text\">Fire rating was tested at the standard 1,200°F furnace temperature for only 30 minutes<\/span>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_Cdgwf9":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"hero_wHDzr4":{"type":"hero","blocks":{"text_c8TK3z":{"type":"text","settings":{"text":"<h2>Still Have Questions?<\/h2>","width":"fit-content","max_width":"narrow","alignment":"left","type_preset":"h1","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal