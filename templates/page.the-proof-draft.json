tyle>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_aNnMhw":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Anton&display=swap');\n\n  .reviews-section {\n    background-color: #11151a;\n    padding: 60px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .reviews-section__summary {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    margin-bottom: 40px;\n    flex-wrap: wrap;\n  }\n\n  .reviews-section__stars {\n    display: flex;\n    gap: 4px;\n  }\n\n  .reviews-section__stars svg {\n    width: 28px;\n    height: 28px;\n    color: #d9b84d;\n    fill: #d9b84d;\n  }\n\n  .reviews-section__rating {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 22px;\n    font-weight: 700;\n    color: #ffffff;\n  }\n\n  .reviews-section__meta {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: #aaaaaa;\n  }\n\n  .reviews-section__grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n\n  .reviews-section__card {\n    background-color: #1a1f27;\n    border: 1px solid #2a2f38;\n    border-radius: 0;\n    padding: 28px;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .reviews-section__card-stars {\n    display: flex;\n    gap: 3px;\n  }\n\n  .reviews-section__card-stars svg {\n    width: 18px;\n    height: 18px;\n    color: #d9b84d;\n    fill: #d9b84d;\n  }\n\n  .reviews-section__card-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    color: #cccccc;\n    line-height: 1.7;\n    flex: 1;\n  }\n\n  .reviews-section__card-author {\n    border-top: 1px solid #2a2f38;\n    padding-top: 14px;\n  }\n\n  .reviews-section__card-name {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 13px;\n    font-weight: 700;\n    color: #ffffff;\n    margin-bottom: 2px;\n  }\n\n  .reviews-section__card-source {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 12px;\n    color: #888888;\n  }\n\n  @media (max-width: 768px) {\n    .reviews-section__grid {\n      grid-template-columns: 1fr;\n    }\n\n    .reviews-section__rating {\n      font-size: 18px;\n    }\n\n    .reviews-section__stars svg {\n      width: 22px;\n      height: 22px;\n    }\n  }\n<\/style>\n\n<div class=\"reviews-section\">\n\n  <div class=\"reviews-section__summary\">\n    <div class=\"reviews-section__stars\">\n      <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n      <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n      <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n      <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n      <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n    <\/div>\n    <span class=\"reviews-section__rating\">4.99<\/span>\n    <span class=\"reviews-section__meta\">out of 5 from 650+ verified reviews<\/span>\n  <\/div>\n\n  <div class=\"reviews-section__grid\">\n\n    <div class=\"reviews-section__card\">\n      <div class=\"reviews-section__card-stars\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n      <\/div>\n      <p class=\"reviews-section__card-text\">\"After doing a lot of research and seeing the positive reviews, I purchased the 4827-6 in black diamond finish. The safe is beautiful and built like a tank. I believe Sturdy Safe produces a great safe at a fair price compared to some of the other names out there.\"<\/p>\n      <div class=\"reviews-section__card-author\">\n        <div class=\"reviews-section__card-name\">Richard T.<\/div>\n        <div class=\"reviews-section__card-source\">Via Google<\/div>\n      <\/div>\n    <\/div>\n\n    <div class=\"reviews-section__card\">\n      <div class=\"reviews-section__card-stars\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n      <\/div>\n      <p class=\"reviews-section__card-text\">\"I've had my Sturdy Safe since 2018 and have had zero issues. I use it daily and feel very confident that someone isn't getting in if my home is burglarized.\"<\/p>\n      <div class=\"reviews-section__card-author\">\n        <div class=\"reviews-section__card-name\">Gary<\/div>\n        <div class=\"reviews-section__card-source\">Via Google<\/div>\n      <\/div>\n    <\/div>\n\n    <div class=\"reviews-section__card\">\n      <div class=\"reviews-section__card-stars\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"\/><\/svg>\n      <\/div>\n      <p class=\"reviews-section__card-text\">\"We bought a Sturdy Safe about 10 years ago and it is so well made. Those safes in the big box stores are junk. Spend the same amount or less and get quality craftsmanship and customization.\"<\/p>\n      <div class=\"reviews-section__card-author\">\n        <div class=\"reviews-section__card-name\">A. Shultz<\/div>\n        <div class=\"reviews-section__card-source\">Via Google<\/div>\n      <\/div>\n    <\/div>\n\n  <\/div>\n\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"main":{"type":"main-page","blocks":{"heading":{"type":"text","name":"Title","settings":{"text":"<h1>{{ closest.page.title }}<\/h1>","width":"100%","max_width":"normal","alignment":"left","type_preset":"h2","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"page-content":{"type":"page-content","settings":{},"blocks":{}}},"block_order":["heading","page-content"],"disabled":true,"settings":{"content_direction":"column","gap":32,"color_scheme":"","padding-block-start":60,"padding-block-end":60}},"section_KVJHDE":{"type":"section","blocks":{"button_Ak4MEY":{"type":"button","name":"t:names.button","settings":{"label":"BUILD & PRICE YOUR SAFE","link":"https:\/\/www.sturdysafe.com\/pages\/safe-configurator","open_in_new_tab":false,"style_class":"button","width":"fit-content","custom_width":100,"width_mobile":"fit-content","custom_width_mobile":100},"blocks":{}}},"block_order":["button_Ak4MEY"],"name":"t:names.rich_text_section","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_a