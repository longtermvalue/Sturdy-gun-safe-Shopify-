rice_kNxzHp":{"type":"price","name":"t:names.product_price","settings":{"show_sale_price_first":true,"show_installments":false,"show_tax_info":false,"type_preset":"h6","width":"100%","alignment":"left","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","color":"var(--color-foreground)","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["product_card_gallery_rPTTaW","product_title_iF4qAV","price_kNxzHp"]}},"name":"t:names.products_carousel","settings":{"collection":"vaults","layout_type":"grid","carousel_on_mobile":false,"max_products":3,"columns":3,"mobile_columns":"2","mobile_card_size":"60cqw","columns_gap":8,"rows_gap":24,"icons_style":"arrow","icons_shape":"circle","section_width":"page-width","horizontal_alignment":"center","gap":28,"color_scheme":"scheme-3","padding-block-start":48,"padding-block-end":48}},"custom_liquid_qwGyc4":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_kpEJL8":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Anton&display=swap');\n\n  .faq-vault-section {\n    background-color: #11151a;\n    padding: 60px 24px;\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    box-sizing: border-box;\n  }\n\n  .faq-vault-section__inner {\n    max-width: 900px;\n    margin: 0 auto;\n  }\n\n  .faq-vault-section__title {\n    font-family: 'Anton', sans-serif;\n    font-size: 36px;\n    font-weight: 400;\n    color: #d4af37;\n    margin: 0 0 40px 0;\n    letter-spacing: 0.01em;\n  }\n\n  .faq-vault-section__list {\n    display: flex;\n    flex-direction: column;\n    border-top: 1px solid #2a2f38;\n  }\n\n  .faq-vault-section__item {\n    border-bottom: 1px solid #2a2f38;\n  }\n\n  .faq-vault-section__question {\n    width: 100%;\n    background: none;\n    border: none;\n    padding: 24px 0;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    cursor: pointer;\n    text-align: left;\n  }\n\n  .faq-vault-section__question-text {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 15px;\n    font-weight: 700;\n    color: #ffffff;\n    line-height: 1.4;\n  }\n\n  .faq-vault-section__icon {\n    flex-shrink: 0;\n    width: 20px;\n    height: 20px;\n    color: #d4af37;\n    transition: transform 0.3s ease;\n  }\n\n  .faq-vault-section__item.is-open .faq-vault-section__icon {\n    transform: rotate(45deg);\n  }\n\n  .faq-vault-section__answer {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.4s ease;\n  }\n\n  .faq-vault-section__item.is-open .faq-vault-section__answer {\n    max-height: 600px;\n  }\n\n  .faq-vault-section__answer-inner {\n    padding: 0 0 24px 0;\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    color: #aaaaaa;\n    line-height: 1.8;\n    max-width: 780px;\n  }\n\n  @media (max-width: 768px) {\n    .faq-vault-section__title {\n      font-size: 26px;\n    }\n\n    .faq-vault-section__question-text {\n      font-size: 14px;\n    }\n\n    .faq-vault-section__answer-inner {\n      font-size: 13px;\n    }\n\n    .faq-vault-section__question {\n      padding: 20px 0;\n    }\n  }\n<\/style>\n\n<div class=\"faq-vault-section\">\n  <div class=\"faq-vault-section__inner\">\n\n    <h2 class=\"faq-vault-section__title\">Frequently Asked Questions<\/h2>\n\n    <div class=\"faq-vault-section__list\">\n\n      <div class=\"faq-vault-section__item\">\n        <button class=\"faq-vault-section__question\">\n          <span class=\"faq-vault-section__question-text\">What room dimensions work for a vault door?<\/span>\n          <svg class=\"faq-vault-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-vault-section__answer\">\n          <p class=\"faq-vault-section__answer-inner\">Our ADA Standard vault door fits a standard 36-inch rough opening. Custom sizes are available for any opening. The door itself is 6 inches deep and can be installed in concrete, wood framing, or steel framing.<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"faq-vault-section__item\">\n        <button class=\"faq-vault-section__question\">\n          <span class=\"faq-vault-section__question-text\">Can a vault door stop a forced entry?<\/span>\n          <svg class=\"faq-vault-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-vault-section__answer\">\n          <p class=\"faq-vault-section__answer-inner\">Yes. Our vault doors use the same heavy plate steel construction as our Heavy Duty safes. The locking mechanism uses multiple deadbolts and the same Sargent & Greenleaf lock. The door cannot be pried open from the hinge side due to the fully recessed hinge design.<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"faq-vault-section__item\">\n        <button class=\"faq-vault-section__question\">\n          <span class=\"faq-vault-section__question-text\">Is fire protection available?<\/span>\n          <svg class=\"faq-vault-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-vault-section__answer\">\n          <p class=\"faq-vault-section__answer-inner\">Yes. The fire-lining option adds ceramic wool insulation to the door panel, providing a fire-rated barrier between the vault room and the rest of the building.<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"faq-vault-section__item\">\n        <button class=\"faq-vault-section__question\">\n          <span class=\"faq-vault-section__question-text\">What is the escape hatch used for?<\/span>\n          <svg class=\"faq-vault-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-vault-section__answer\">\n          <p class=\"faq-vault-section__answer-inner\">The escape hatch provides a secondary exit from the vault room. It locks from the inside and is sized for a person to crawl through. It is installed in a wall panel adjacent to the vault door for emergency egress.<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"faq-vault-section__item\">\n        <button class=\"faq-vault-section__question\">\n          <span class=\"faq-vault-section__question-text\">Can I get a custom size vault door?<\/span>\n          <svg class=\"faq-vault-section__icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m7.5-7.5h-15\"\/>\n          <\/svg>\n        <\/button>\n        <div class=\"faq-vault-section__answer\">\n          <p class=\"faq-vault-section__answer-inner\">Yes. We build vault doors to any opening dimensions. Contact our team with your rough opening width, height, and wall depth for a quote. Lead time on custom vault doors is 6–8 weeks.<\/p>\n        <\/div>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\n  document.querySelectorAll('.faq-vault-section__question').forEach(button => {\n    button.addEventListener('click', () => {\n      const item = button.closest('.faq-vault-section__item');\n      const isOpen = item.classList.contains('is-open');\n\n      document.querySelectorAll('.faq-vault-section__item.is-open').forEach(open => {\n        open.classList.remove('is-open');\n      });\n\n      if (!isOpen) {\n        item.classList.add('is-open');\n      }\n    });\n  });\n<\/script>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_zrhLxT":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .divider-wrap {\n    width: 100vw;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    background-color: #2b0101;\n    padding: 0;\n    line-height: 0;\n  }\n\n  .divider-line {\n    width: 100%;\n    height: 1px;\n    background-color: #444444;\n    border: none;\n    margin: 0;\n  }\n<\/style>\n\n<div class=\"divider-wrap\">\n  <div class=\"divider-line\"><\/div>\n<\/div>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"hero_iKrJx9":{"type":"hero","blocks":{"text_BP3iEL":{"type":"text","settings":{"text":"<h2>Talk to a Vault Door Expert<\/h2>","width":"fit-content","max_width":"narrow","alignment":"left","type_preset":"h1","font":"var(--font-body--family)","font_size":"1rem","line_hei