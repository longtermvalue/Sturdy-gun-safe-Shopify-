 color: #ffffff;\n    line-height: 1.5;\n    max-width: 140px;\n  }\n\n  @media (max-width: 768px) {\n    .features-section {\n      padding: 48px 20px;\n    }\n\n    .features-section__title {\n      font-size: 20px;\n      margin-bottom: 36px;\n    }\n\n    .features-section__grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 36px 16px;\n      justify-items: center;\n      width: 100%;\n    }\n\n    .features-section__item {\n      flex: unset;\n      width: 100%;\n      max-width: 160px;\n    }\n\n    .features-section__item:last-child:nth-child(odd) {\n      grid-column: 1 \/ -1;\n    }\n\n    .features-section__label {\n      font-size: 12px;\n      max-width: 130px;\n    }\n  }\n<\/style>\n\n<div class=\"features-section\">\n  <h2 class=\"features-section__title\">Standard Features — Every Sturdy Vault Door<\/h2>\n\n  <div class=\"features-section__grid\">\n\n    <div class=\"features-section__item\">\n      <div class=\"features-section__icon-wrap\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3\"\/>\n        <\/svg>\n      <\/div>\n      <span class=\"features-section__label\">Heavy plate steel construction<\/span>\n    <\/div>\n\n    <div class=\"features-section__item\">\n      <div class=\"features-section__icon-wrap\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z\"\/>\n        <\/svg>\n      <\/div>\n      <span class=\"features-section__label\">Multiple deadbolt locking system<\/span>\n    <\/div>\n\n    <div class=\"features-section__item\">\n      <div class=\"features-section__icon-wrap\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z\"\/>\n        <\/svg>\n      <\/div>\n      <span class=\"features-section__label\">S&G lock (mechanical or electronic)<\/span>\n    <\/div>\n\n    <div class=\"features-section__item\">\n      <div class=\"features-section__icon-wrap\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z\"\/>\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z\"\/>\n        <\/svg>\n      <\/div>\n      <span class=\"features-section__label\">2,300°F ceramic wool fire lining<\/span>\n    <\/div>\n\n    <div class=\"features-section__item\">\n      <div class=\"features-section__icon-wrap\">\n        <svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.75\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.3